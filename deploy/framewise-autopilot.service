# Template (not installed): one unattended autopilot run over an episode, on the user's Claude plan.
# Install only when asked:  sudo cp deploy/framewise-autopilot.{service,timer} /etc/systemd/system/ && sudo systemctl enable --now framewise-autopilot.timer
[Unit]
Description=Framewise autopilot (headless Claude Code session)
After=framewise.service

[Service]
Type=oneshot
User=bytoshi
WorkingDirectory=/home/bytoshi/app-projects/video-analyzer
Environment=FRAMEWISE_URL=http://chopper.local:8080
ExecStart=/home/bytoshi/app-projects/video-analyzer/scripts/autopilot-headless.sh "Episode 6"
TimeoutStartSec=24h
