[Unit]
Description=Framewise video analysis (Docker Compose)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/bytoshi/app-projects/video-analyzer
ExecStart=/usr/bin/docker compose up -d --no-build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
