# Isolate GPU libraries from the CPU media API and install only this GPU architecture.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 DATA_DIR=/data TMPDIR=/data/tmp HOME=/home/appuser \
    HF_HOME=/models/cache/huggingface TORCH_HOME=/models/cache/torch XDG_CACHE_HOME=/models/cache
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg git ca-certificates libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# AMD's gfx1201 wheels keep the ROCm runtime and PyTorch versions pinned without CUDA.
RUN python -m pip install --no-cache-dir --extra-index-url https://repo.amd.com/rocm/whl-multi-arch/ \
      'torch[device-gfx1201]==2.11.0+rocm7.14.1' 'torchvision[device-gfx1201]==0.26.0+rocm7.14.1'
RUN python -m pip install --no-cache-dir 'accelerate==1.14.0' 'huggingface-hub==1.21.0' 'matplotlib==3.11.0' 'numpy==2.2.6' 'Pillow==12.2.0' 'pycocotools==2.0.11' 'qwen_vl_utils==0.0.14' 'safetensors==0.8.0' 'scipy==1.18.1' 'supervision==0.31.0' 'transformers==5.12.1' && \
    python -m pip install --no-cache-dir --no-deps 'git+https://github.com/Tencent/WeVisOne-VL.git@9a6bcd85404505df0d05cfb5d97512ccacf35dee' && \
    python -m pip check && python -c 'import torch; assert torch.version.hip, "Expected ROCm PyTorch"'
COPY backend/app ./app
RUN groupadd --gid 10001 appuser && useradd --system --uid 10001 --gid 10001 --create-home appuser
USER appuser
CMD ["python", "-m", "app.inference_worker"]
