APP_PORT=8080
APP_BIND_IP=127.0.0.1
MAX_UPLOAD_GB=40
DATA_VOLUME=framewise_data
MODEL_VOLUME=framewise_models
VIDEO_GID=44
RENDER_GID=991
# Bearer token that lets other machines on the LAN call http://<host>:8080/v1/chat/completions (OpenAI-compatible, Qwen 3.6).
# Leave it empty to keep that endpoint disabled. Generate one with: openssl rand -hex 24
# CHAT_API_KEY=
# Required for the optional analysis worker. Do not commit your actual key.
# OPENROUTER_API_KEY=
# WEVISONE_MODEL_DIR=/absolute/path/to/.models/wevisone-4b
# ANIREF_MODEL_DIR=/absolute/path/to/.models/aniref
# ANIME_REID_MODEL_DIR=/absolute/path/to/.models/anime-reid
# CAPTION_MODEL_DIR=/absolute/path/to/.models/qwen3-vl-2b
# One resident Qwen 3.6 server for text and pictures. Concurrency (defaults shown); recreate the inference worker after a change.
# QWEN36_SLOTS=            # server slots; empty = the widest stage below (4)
# QWEN36_KV_UNIFIED=1      # one KV pool shared by the slots
# TEXT_JOB_CONCURRENCY=2   # text jobs at once (each gets CONTEXT_SIZE / this tokens)
# FRAME_PARALLEL=4         # first frames described at once
# KEYFRAME_PARALLEL=2      # keyframe windows described at once (16384 tokens each)
# SUBTITLE_READ_PARALLEL=4 # subtitle strips read at once
# QWEN36_CONTEXT_SIZE=65536
# QWEN36_THINKING_BUDGET=2048
# TEXT_MODEL_DIR=/absolute/path/to/.models/qwen3.6-35b
# Optional MTP build of the same model (scripts/download-qwen36-mtp.sh); pick it in the text engine dialog.
# TEXT_MTP_MODEL_DIR=/absolute/path/to/.models/qwen3.6-35b-mtp
# QWEN36_MTP_ARGS=--spec-type draft-mtp --spec-draft-n-max 3
# COMPOSE_FILE=compose.yml:compose.inference.rocm.yml
# COMPOSE_PROFILES=inference
