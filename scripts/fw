#!/usr/bin/env python3
"""Drive Framewise from a terminal or an agent: queue steps over cut ranges, wait for the queue, list what needs a person.

    scripts/fw episodes                          # find an episode (id, or "Project / Episode" text)
    scripts/fw boxes "Episode 6" 100-120         # first-frame boxes for cuts 100..120
    scripts/fw visual "Episode 6" 5-10           # visual analysis (keyframes and beats follow)
    scripts/fw summary "Episode 6" all --redo    # write every Cut summary again
    scripts/fw wait "Episode 6" --jobs ID,ID     # until those jobs finish
    scripts/fw review "Episode 6"                # what waits for a person
    scripts/fw next "Episode 6" --go             # queue the next step of the gated flow
    scripts/fw drive "Episode 6"                 # repeat next/wait until a person is needed

Cut numbers are the editor's (1-based). RANGE is 100-120, 100..120, 7, 5- (to the end), -10 or all (the default).
Only the HTTP API is used (FRAMEWISE_URL, else http://<APP_BIND_IP in .env>:8080, else http://192.168.0.6:8080).
It queues, waits, retries, dismisses, cancels and reads. It never edits labels, boxes, transcript text, answers,
dialogue or sequences, and never restarts containers.

Exit codes: 0 ok or done, 1 error, 2 blocked on a person, 3 busy (work is queued or running).
"""
import argparse
import json
import math
import os
import re
import sys
import time
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import quote, urlencode
from urllib.request import Request, urlopen

OK, ERROR, BLOCKED, BUSY = 0, 1, 2, 3
DEFAULT_URL = 'http://192.168.0.6:8080'
POLL_SECONDS = 15
# speaker_attribution leaves this reason itself when some windows went unanswered; running it again would not settle it.
UNANSWERED_ATTRIBUTION = 'Some lines could not be attributed'
FINISHED = ('done', 'failed', 'cancelled')


class Failure(Exception):
    pass


def base_url():
    if url := os.environ.get('FRAMEWISE_URL'):
        return url.rstrip('/')
    try:
        for line in (Path(__file__).resolve().parent.parent / '.env').read_text().splitlines():
            key, _, value = line.partition('=')
            if key.strip() == 'APP_BIND_IP' and value.strip():
                return f'http://{value.strip()}:8080'
    except OSError:
        pass
    return DEFAULT_URL


class Api:
    def __init__(self, url, dry_run=False):
        self.url, self.dry_run = url, dry_run

    def call(self, method, path, params=None, body=None):
        query = urlencode({key: str(value).lower() if isinstance(value, bool) else value
                           for key, value in (params or {}).items() if value is not None})
        url = f'{self.url}{path}' + (f'?{query}' if query else '')
        if self.dry_run and method != 'GET':
            print(f'dry run: {method} {url}' + (f' {json.dumps(body)}' if body is not None else ''))
            return {'dry_run': True, 'job_ids': []}
        data = json.dumps(body).encode() if body is not None else (b'' if method != 'GET' else None)
        headers = {'Content-Type': 'application/json'} if body is not None else {}
        try:
            with urlopen(Request(url, data=data, method=method, headers=headers), timeout=120) as response:
                raw = response.read()
        except HTTPError as exc:
            detail = exc.read().decode(errors='replace')
            try:
                detail = json.loads(detail).get('detail', detail)
            except (ValueError, AttributeError):
                pass
            raise Failure(f'{method} {path}: HTTP {exc.code}: {detail}') from None
        except (URLError, TimeoutError) as exc:
            raise Failure(f'cannot reach {self.url}: {getattr(exc, "reason", exc)}') from None
        return json.loads(raw) if raw else {}

    def get(self, path, params=None):
        return self.call('GET', path, params)

    def post(self, path, params=None, body=None):
        return self.call('POST', path, params, body)


# --- small helpers -----------------------------------------------------------------------------------------------

def parse_range(text):
    """'100-120' -> (100, 120); '7' -> (7, 7); '5-' -> (5, None); '-10' -> (None, 10); 'all' -> (None, None)."""
    text = (text or 'all').strip().lower()
    if text in ('all', '*', ''):
        return None, None
    if text.isdigit():
        return int(text), int(text)
    match = re.fullmatch(r'(\d+)?\s*(?:-|\.\.|to)\s*(\d+)?', text)
    if not match or not any(match.groups()):
        raise Failure(f'cannot read the cut range {text!r}: use 100-120, 7, 5-, -10 or all')
    first, last = (int(value) if value else None for value in match.groups())
    if (first is not None and first < 1) or (last is not None and last < 1):
        raise Failure('cut numbers start at 1')
    if first is not None and last is not None and last < first:
        raise Failure(f'the range {text!r} ends before it starts')
    return first, last


def range_text(span):
    first, last = span
    if first is None and last is None:
        return 'all cuts'
    if first == last:
        return f'cut {first}'
    return f"cuts {first or 1}-{last if last is not None else 'end'}"


def numbers_text(numbers, limit=12):
    """[1,2,3,5,9,10] -> '1-3, 5, 9-10'."""
    spans, numbers = [], sorted(set(numbers))
    for number in numbers:
        if spans and number == spans[-1][1] + 1:
            spans[-1][1] = number
        else:
            spans.append([number, number])
    parts = [f'{a}' if a == b else f'{a}-{b}' for a, b in spans]
    return ', '.join(parts[:limit]) + (f', … ({len(numbers)} cuts)' if len(parts) > limit else '')


def emit(args, data, text):
    if args.json:
        print(json.dumps(data, indent=1, ensure_ascii=False))
    elif text:
        print(text)


# --- episodes and cuts -------------------------------------------------------------------------------------------

def all_episodes(api):
    return [{**episode, 'project_id': project['id'], 'project': project['title']}
            for project in api.get('/api/projects') for episode in project.get('episodes', [])]


def match_episodes(episodes, ref):
    """Episodes named by ``ref``: an id, an exact title, or text found in "Project / Episode" (both sides with a slash)."""
    needle = ref.strip().lower()
    by_id = [episode for episode in episodes if episode['id'].lower() == needle or episode['id'].lower().startswith(needle) and len(needle) >= 8]
    if by_id:
        return by_id
    exact = [episode for episode in episodes if episode['title'].lower() == needle or f"{episode['project']} / {episode['title']}".lower() == needle]
    if exact:
        return exact
    if '/' in needle:
        project, _, title = (part.strip() for part in needle.rpartition('/'))
        found = [episode for episode in episodes if project in episode['project'].lower() and title in episode['title'].lower()]
        # "Show / Episode 1" means Episode 1, not Episode 10
        return [episode for episode in found if episode['title'].lower() == title] or found
    return [episode for episode in episodes if needle in f"{episode['project']} / {episode['title']}".lower()]


def find_episode(api, ref, latest=False):
    episodes = all_episodes(api)
    if latest:
        if not episodes:
            raise Failure('there are no episodes')
        return max(episodes, key=lambda episode: episode['created_at'])
    if not ref:
        raise Failure('name an episode: its id, "Project / Episode" text, or --latest')
    found = match_episodes(episodes, ref)
    if len(found) == 1:
        return found[0]
    if not found:
        raise Failure(f'no episode matches {ref!r}; list them with: fw episodes')
    listing = '\n'.join(f"  {episode['id']}  {episode['project']} / {episode['title']}" for episode in found)
    raise Failure(f'{ref!r} matches {len(found)} episodes; use the id or a longer name:\n{listing}')


def cuts(api, episode_id):
    items, offset = [], 0
    while offset is not None:
        page = api.get(f'/api/v1/episodes/{episode_id}/cuts', {'offset': offset, 'limit': 500})
        items += page['items']
        offset = page.get('next_offset')
    return items


def in_range(items, span):
    first, last = span
    return [cut for cut in items if (first or 1) <= cut['cut_index'] + 1 <= (last if last is not None else math.inf)]


def review(api, episode_id, span=(None, None)):
    try:
        return api.get(f'/api/episodes/{episode_id}/review', {'from_cut': span[0], 'to_cut': span[1]})
    except Failure as exc:
        if 'HTTP 404' in str(exc) and 'Episode not found' not in str(exc):
            raise Failure('the server has no /review endpoint yet: rebuild and restart video-analyzer on the host') from None
        raise


def queue(api, episode_id):
    return api.get(f'/api/episodes/{episode_id}/queue')


def ui_link(api, episode):
    return f"{api.url}/#/episode/{episode['id']}"


# --- steps -------------------------------------------------------------------------------------------------------

def job_ids(result):
    ids = list(result.get('job_ids') or [])
    if result.get('job_id'):
        ids.append(result['job_id'])
    return ids


def batch(path, **choices):
    """An episode endpoint that takes from_cut/to_cut. ``choices`` map query names to functions of the parsed arguments."""
    def run(api, episode, span, args):
        params = {'from_cut': span[0], 'to_cut': span[1], **{name: pick(args) for name, pick in choices.items()}}
        return api.post(path.format(id=episode['id']), params)
    return run


def per_cut(path, body=None):
    """One request per enabled cut in the range, for steps whose work is per cut anyway."""
    def run(api, episode, span, args):
        selected = in_range(cuts(api, episode['id']), span)
        ids, skipped, errors = [], [], []
        for cut in selected:
            number = cut['cut_index'] + 1
            if not cut['analysis_enabled']:
                skipped.append(number)
                continue
            try:
                ids += job_ids(api.post(path.format(cut=cut['id']), body=body))
            except Failure as exc:
                errors.append({'cut': number, 'error': str(exc)})
        return {'queued': len(ids), 'job_ids': ids, 'skipped_disabled': skipped, 'errors': errors, 'dry_run': api.dry_run}
    return run


def whole(make):
    """A step that works on the whole episode."""
    def run(api, episode, span, args):
        if span != (None, None):
            raise Failure('this step works on the whole episode; leave out the cut range')
        return make(api, episode, args)
    return run


def language_for(api, episode, args):
    language = args.language or review(api, episode['id'])['episode'].get('subtitle_language')
    if not language:
        raise Failure('state the subtitle language with --language (for example --language Japanese)')
    return language


def transcribe(api, episode, span, args):
    if span == (None, None):
        return api.post(f"/api/episodes/{episode['id']}/transcribe")
    selected = in_range(cuts(api, episode['id']), span)
    if not selected:
        raise Failure(f'no active cut in {range_text(span)}')
    body = {'start_time': selected[0]['start_time'], 'end_time': selected[-1]['end_time'], 'replace_manual': args.replace_manual}
    return api.post(f"/api/episodes/{episode['id']}/transcribe-range", body=body)


not_redo = lambda args: not args.redo  # noqa: E731

STEPS = {
    'setup': (whole(lambda api, episode, args: api.post(f"/api/episodes/{episode['id']}/prepare", body={'language': language_for(api, episode, args)})),
              'media, cut detection, transcription, subtitles, boxes and recognition (skips what is done)'),
    'boxes': (batch('/api/episodes/{id}/character-boxes'), 'first-frame boxes for cuts without a current detection'),
    'recognize': (lambda api, episode, span, args: batch('/api/episodes/{id}/character-detection-rerun' if args.redo
                                                         else '/api/episodes/{id}/character-detection')(api, episode, span, args),
                  'name the boxes from the gallery; --redo replaces automatic labels (manual labels stay)'),
    'characters': (batch('/api/episodes/{id}/character-detection-all'), 'boxes and recognition in one pass'),
    'target-frames': (batch('/api/episodes/{id}/target-detection', only_missing=not_redo), 'people on the evaluated frames'),
    'keyframes': (per_cut('/api/cuts/{cut}/keyframe-selection', body={}), 'keyframe selection (visual queues it when needed)'),
    'visual': (batch('/api/episodes/{id}/visual-analysis', only_missing=not_redo), 'first frame and keyframe analysis; beats follow'),
    'beats': (per_cut('/api/cuts/{cut}/performance-beats'), 'performance beats from the current keyframes'),
    'consistency': (batch('/api/episodes/{id}/consistency-summaries', only_missing=not_redo), 'the consistency review'),
    'answers': (batch('/api/episodes/{id}/review-answers', auto_save=lambda args: args.save),
                "draft answers to the review's questions; kept as suggestions unless --save"),
    'summary': (batch('/api/episodes/{id}/cut-summaries', only_missing=not_redo), 'Cut summaries; --redo writes them again'),
    'text-chain': (batch('/api/episodes/{id}/text-chain', only_missing=not_redo), 'review, auto-saved answers and Cut summary unattended'),
    'transcribe': (transcribe, 'transcribe again (a range re-transcribes from the first cut start to the last cut end)'),
    'subtitles': (whole(lambda api, episode, args: api.post(f"/api/episodes/{episode['id']}/subtitles", body={'language': language_for(api, episode, args)})),
                  'read the burned-in subtitles'),
    'speakers': (whole(lambda api, episode, args: api.post(f"/api/episodes/{episode['id']}/speaker-attribution")), 'speaker attribution'),
}

# Checkpoints that should be settled before a step, so an explicit request can warn about them.
UPSTREAM = {'target-frames': ('first_frame',), 'keyframes': ('first_frame',), 'visual': ('first_frame', 'target_frames'),
            'beats': ('first_frame', 'target_frames'), 'consistency': ('first_frame', 'target_frames', 'voices'),
            'answers': ('first_frame', 'target_frames', 'voices'), 'text-chain': ('first_frame', 'target_frames', 'voices'),
            'summary': ('decisions',)}


def gate_lines(report, names):
    gates, lines = report['gates'], []
    for name in names:
        items = gates.get(name) or []
        if not items:
            continue
        if name == 'voices':
            voices = [f"{voice['speaker_label'] or '(no label)'} ({voice['lines']} lines)" for voice in items[:6]]
            lines.append('unknown voices: ' + ', '.join(voices))
        else:
            label = {'first_frame': 'unlabeled first-frame boxes', 'target_frames': 'target frames to review',
                     'decisions': 'review questions without saved answers'}[name]
            lines.append(f"{label}: cuts {numbers_text(item['cut'] for item in items)}")
    return lines


def describe_result(step, span, result):
    if result.get('dry_run'):
        return ''
    ids = job_ids(result)
    parts = [f"{step} ({range_text(span)}): " + (f"queued {len(ids)} job(s)" if ids else 'nothing queued')]
    if result.get('deferred'):
        parts.append('deferred until cut detection finishes')
    skipped = result.get('skipped')
    if isinstance(skipped, int) and skipped:
        parts.append(f'skipped {skipped} cut(s) that already have it')
    for reason, numbers in (skipped if isinstance(skipped, dict) else {}).items():
        if numbers:
            parts.append(f"skipped ({reason.replace('_', ' ')}): cuts {numbers_text(numbers)}")
    if result.get('skipped_disabled'):
        parts.append(f"skipped (analysis off): cuts {numbers_text(result['skipped_disabled'])}")
    for reason, numbers in (result.get('blocked') or {}).items():
        if numbers:
            parts.append(f"not ready ({reason.replace('_', ' ')}): cuts {numbers_text(numbers)}")
    for error in result.get('errors') or []:
        parts.append(f"cut {error['cut']}: {error['error']}")
    if ids:
        parts.append('jobs: ' + ','.join(ids))
    return '\n'.join(parts)


def run_step(api, episode, step, span, args):
    return STEPS[step][0](api, episode, span, args)


def cmd_step(api, args):
    episode = find_episode(api, args.episode, args.latest)
    span = parse_range(args.range)
    try:
        report = review(api, episode['id'], span)
    except Failure as exc:
        if span != (None, None) and 'no /review endpoint' in str(exc):
            # A server without the review report predates to_cut: it would quietly queue the cuts after the range too.
            raise Failure('this server does not understand cut ranges yet: rebuild and restart video-analyzer on the host first') from None
        report = None
    warnings = gate_lines(report, UPSTREAM[args.step]) if report and args.step in UPSTREAM else []
    result = run_step(api, episode, args.step, span, args)
    text = describe_result(args.step, span, result)
    if warnings:
        text += '\nwarning: open checkpoints in this range (queued anyway because you asked):\n  ' + '\n  '.join(warnings)
    emit(args, {'step': args.step, 'range': span, 'result': result, 'warnings': warnings}, text)
    return ERROR if result.get('errors') and not job_ids(result) else OK


# --- the gated flow ----------------------------------------------------------------------------------------------

def plan(report, queue_state, language=None):
    """The next move of the automatic flow: {'action': 'busy'|'run'|'blocked'|'done', ...}.

    Order: setup → speaker attribution → [first-frame names] → target frames → [target frame review] → visual
    analysis → beats → [unknown voices] → consistency review → suggested answers → [your answers] → Cut summaries.
    Bracketed steps are checkpoints for a person. Stale results are listed, never re-run: that is the user's call.
    """
    running = queue_state.get('running') or []
    if running or queue_state.get('waiting_total'):
        labels = [f"{run['label']} ({run['status']})" for run in running][:3]
        return {'action': 'busy', 'detail': f"running: {', '.join(labels) or 'none'}; waiting: {queue_state.get('waiting_total', 0)}"}
    if report['failures']:
        return {'action': 'blocked', 'gate': 'failures', 'items': report['failures'],
                'detail': f"{len(report['failures'])} failed run(s) need a decision: fw failures, then fw retry ID or fw dismiss ID"}
    setup, progress, gates, checks = report['setup'], report['progress'], report['gates'], report['checks']
    if not all(setup.values()):
        language = language or report['episode'].get('subtitle_language')
        missing = [name for name, done in setup.items() if not done]
        if not language:
            return {'action': 'blocked', 'gate': 'language', 'detail': f"setup needs the subtitle language ({', '.join(missing)} missing): add --language"}
        return {'action': 'run', 'step': 'setup', 'language': language, 'detail': f"missing: {', '.join(missing)}"}
    stale = checks.get('speaker_attribution_stale')
    if stale and stale != UNANSWERED_ATTRIBUTION:
        return {'action': 'run', 'step': 'speakers', 'detail': f'speaker attribution is stale: {stale}'}
    def run(step, numbers):
        return {'action': 'run', 'step': step, 'cuts': numbers, 'detail': f'cuts {numbers_text(numbers)}'}

    def blocked(gate):
        return {'action': 'blocked', 'gate': gate, 'items': gates[gate], 'detail': '; '.join(gate_lines(report, (gate,)))}

    if gates['first_frame']:
        return blocked('first_frame')
    if progress['target_missing']:
        return run('target-frames', progress['target_missing'])
    if gates['target_frames']:
        return blocked('target_frames')
    if progress['visual_missing']:
        return run('visual', progress['visual_missing'])
    if progress['beats_missing']:
        return run('beats', progress['beats_missing'])
    if gates['voices']:
        return blocked('voices')
    if progress['consistency_missing']:
        return run('consistency', progress['consistency_missing'])
    if drafts := [item['cut'] for item in gates['decisions'] if not item['draft']]:
        return {**run('answers', drafts), 'detail': f'suggested answers for cuts {numbers_text(drafts)}'}
    if gates['decisions']:
        return blocked('decisions')
    if progress['summary_missing']:
        return run('summary', progress['summary_missing'])
    return {'action': 'done', 'detail': 'nothing left for the automatic flow'}


def execute(api, episode, decision, args):
    """Queue what ``plan`` chose. Steps limited to some cuts go per cut or as the smallest covering range."""
    step = decision['step']
    numbers = decision.get('cuts') or []
    if step == 'setup':
        return api.post(f"/api/episodes/{episode['id']}/prepare", body={'language': decision['language']})
    if step == 'speakers':
        return api.post(f"/api/episodes/{episode['id']}/speaker-attribution")
    if step in ('beats', 'answers'):
        # per cut: the episode endpoints would also redo cuts that already have them
        path = '/api/cuts/{cut}/performance-beats' if step == 'beats' else '/api/cuts/{cut}/review-answers'
        wanted = set(numbers)
        ids, errors = [], []
        for cut in cuts(api, episode['id']):
            if cut['cut_index'] + 1 in wanted:
                try:
                    ids += job_ids(api.post(path.format(cut=cut['id'])))
                except Failure as exc:
                    errors.append({'cut': cut['cut_index'] + 1, 'error': str(exc)})
        return {'queued': len(ids), 'job_ids': ids, 'errors': errors}
    span = (min(numbers), max(numbers)) if numbers else (None, None)
    flags = argparse.Namespace(redo=False, save=False, language=None, replace_manual=False)
    return run_step(api, episode, step, span, flags)


def summary_line(decision):
    action = decision['action']
    if action == 'run':
        return f"next: {decision['step']} · {decision.get('detail', '')}"
    if action == 'blocked':
        return f"blocked on a person ({decision['gate']}): {decision.get('detail', '')}"
    return f"{action}: {decision.get('detail', '')}"


def cmd_next(api, args):
    episode = find_episode(api, args.episode, args.latest)
    decision = plan(review(api, episode['id']), queue(api, episode['id']), args.language)
    text = summary_line(decision)
    if decision['action'] == 'run' and args.go:
        result = execute(api, episode, decision, args)
        decision['result'] = result
        text += '\n' + describe_result(decision['step'], (min(decision['cuts']), max(decision['cuts'])) if decision.get('cuts') else (None, None), result)
    elif decision['action'] == 'run':
        text += '\n(add --go to queue it)'
    if decision['action'] in ('blocked', 'done'):
        text += f'\nopen the episode: {ui_link(api, episode)}'
    emit(args, decision, text)
    return {'run': OK, 'done': OK, 'blocked': BLOCKED, 'busy': BUSY}[decision['action']]


def wait_queue(api, episode_id, timeout, quiet=False):
    """Poll until the episode has nothing queued or running. True when idle, False on timeout."""
    deadline, last = time.time() + timeout if timeout else math.inf, None
    while True:
        state = queue(api, episode_id)
        running = state.get('running') or []
        line = ' · '.join([f"{run['label']}: {run['stage']}" + (f" ({run['units']['done']}/{run['units']['total']})" if run['units']['total'] else '')
                           for run in running[:3]] + [f"waiting {state.get('waiting_total', 0)}"])
        if not running and not state.get('waiting_total'):
            return True
        if line != last and not quiet:
            print(time.strftime('%H:%M:%S'), line, flush=True)
            last = line
        if time.time() >= deadline:
            return False
        time.sleep(POLL_SECONDS)


def wait_jobs(api, ids, timeout):
    deadline, last = time.time() + timeout if timeout else math.inf, {}
    while True:
        states = {job_id: api.get(f'/api/v1/jobs/{quote(job_id)}') for job_id in ids}
        for job_id, job in states.items():
            key = (job['status'], job['stage'])
            if last.get(job_id) != key:
                print(time.strftime('%H:%M:%S'), f"{job['pipeline']} {job_id[:8]}: {job['status']} · {job['stage']}", flush=True)
                last[job_id] = key
        if all(job['status'] in FINISHED for job in states.values()):
            failed = [job for job in states.values() if job['status'] == 'failed']
            for job in failed:
                print(f"failed {job['id']}: {(job['error'] or '')[:300]}")
            return ERROR if failed else OK
        if time.time() >= deadline:
            return BUSY
        time.sleep(POLL_SECONDS)


def cmd_wait(api, args):
    if args.jobs:
        return wait_jobs(api, [job.strip() for job in args.jobs.split(',') if job.strip()], args.timeout)
    episode = find_episode(api, args.episode, args.latest)
    if not wait_queue(api, episode['id'], args.timeout):
        print('still busy (timeout)')
        return BUSY
    failures = review(api, episode['id'])['failures']
    print('idle' + (f'; {len(failures)} failed run(s): fw failures' if failures else ''))
    return ERROR if failures else OK


def cmd_drive(api, args):
    """next --go, wait, again; stop when a person is needed, when done, or when a step makes no progress."""
    episode = find_episode(api, args.episode, args.latest)
    print(f"driving {episode['project']} / {episode['title']} ({episode['id']})", flush=True)
    previous = None
    while True:
        decision = plan(review(api, episode['id']), queue(api, episode['id']), args.language)
        if decision['action'] == 'busy':
            print(time.strftime('%H:%M:%S'), summary_line(decision), flush=True)
            wait_queue(api, episode['id'], 0)
            continue
        if decision['action'] != 'run':
            print(summary_line(decision))
            print(f'open the episode: {ui_link(api, episode)}')
            return BLOCKED if decision['action'] == 'blocked' else OK
        key = (decision['step'], tuple(decision.get('cuts') or ()))
        if key == previous:
            print(f"stopped: {decision['step']} ran but the same cuts still need it ({decision.get('detail', '')}); check them by hand")
            return BLOCKED
        previous = key
        print(time.strftime('%H:%M:%S'), summary_line(decision), flush=True)
        result = execute(api, episode, decision, args)
        print(describe_result(decision['step'], (min(decision['cuts']), max(decision['cuts'])) if decision.get('cuts') else (None, None), result), flush=True)
        if not job_ids(result):
            print(f"stopped: {decision['step']} queued nothing; check those cuts by hand")
            return BLOCKED
        wait_queue(api, episode['id'], 0)


# --- reading -----------------------------------------------------------------------------------------------------

def cmd_health(api, args):
    emit(args, api.get('/api/health'), f'{api.url}: ok')
    return OK


def cmd_episodes(api, args):
    episodes = all_episodes(api)
    if args.project:
        needle = args.project.lower()
        episodes = [episode for episode in episodes if needle in episode['project'].lower() or episode['project_id'] == args.project]
    text = '\n'.join(f"{episode['id']}  {episode['project']} / {episode['title']}  ({episode['status']})" for episode in episodes)
    emit(args, episodes, text or 'no episodes')
    return OK


def status_text(api, episode, report, state):
    setup = ' '.join(f"{name} {'ok' if done else 'MISSING'}" for name, done in report['setup'].items())
    progress = report['progress']
    counts = ' · '.join(f"{name.replace('_', ' ')} {len(progress[name])}" for name in
                        ('boxes_missing', 'target_missing', 'visual_missing', 'beats_missing', 'consistency_missing', 'summary_missing'))
    gates = ' · '.join(f"{name.replace('_', ' ')} {len(items)}" for name, items in report['gates'].items())
    running = ', '.join(f"{run['label']} ({run['stage']})" for run in state.get('running') or []) or 'nothing'
    return '\n'.join([
        f"{episode['project']} / {episode['title']}  {episode['id']}",
        f"subtitle language: {report['episode'].get('subtitle_language') or 'not set'}",
        f"setup: {setup}",
        f"cuts: {progress['cuts']} active, {progress['enabled']} enabled · {counts}",
        f"waiting for a person: {gates}",
        f"queue: running {running}; waiting {state.get('waiting_total', 0)}",
        f"failures: {len(report['failures'])}" + (' (fw failures)' if report['failures'] else ''),
        f"ui: {ui_link(api, episode)}"])


def cmd_status(api, args):
    episode = find_episode(api, args.episode, args.latest)
    report, state = review(api, episode['id']), queue(api, episode['id'])
    emit(args, {'episode': episode, 'review': report, 'queue': state}, status_text(api, episode, report, state))
    return OK


def cmd_queue(api, args):
    episode = find_episode(api, args.episode, args.latest)
    state = queue(api, episode['id'])
    lines = [f"running: {run['label']} · {run['stage']} · {run['units']['done']}/{run['units']['total']} · {run['id']}" for run in state.get('running') or []]
    lines += [f"waiting: {group['count']} × {group['label']} (group {group['group']})" for group in state.get('waiting_groups') or []]
    if any((state.get('elsewhere') or {}).values()):
        lines.append(f"elsewhere on the GPU: {json.dumps(state['elsewhere'], ensure_ascii=False)[:200]}")
    lines.append(f"failed: {len(state.get('attention') or [])}")
    emit(args, state, '\n'.join(lines))
    return OK


def cmd_failures(api, args):
    episode = find_episode(api, args.episode, args.latest)
    items = review(api, episode['id'])['failures']
    text = '\n'.join(f"{item['id']}  {item['label']}" + (f" (cuts {item['cut_span']['first']}-{item['cut_span']['last']})" if item.get('cut_span') else '')
                     + f"  retry: {'yes' if item['retry'] else 'no'}\n    {item['error']}" for item in items) or 'no failures'
    emit(args, items, text)
    return OK


def review_text(api, episode, report):
    gates, checks = report['gates'], report['checks']
    lines = [f"{episode['project']} / {episode['title']}" + (f" · {range_text((report['range']['from_cut'], report['range']['to_cut']))}" if report.get('range') else '')]
    lines.append('CHECKPOINTS (the automatic flow waits for these):')
    gate_text = {
        'first_frame': lambda item: f"cut {item['cut']}: {item['unlabeled_boxes']} first-frame box(es) without a character (Characters panel)",
        'target_frames': lambda item: f"cut {item['cut']}: " + ', '.join(
            [f"frame {frame['ordinal']} {'/'.join(frame['flags'])}" for frame in item['frames']]
            + ([f"{item['unnamed_people']} unnamed person(s)"] if item['unnamed_people'] else [])) + ' (Target frames tab)',
        'voices': lambda item: f"voice {item['speaker_label'] or '(no label)'}: {item['lines']} line(s) without a character, first at {item['first_time']}s (Audio → Unknown voices)",
        'decisions': lambda item: f"cut {item['cut']}: {item['questions']} review question(s) to answer" + (' (a suggested draft is ready)' if item['draft'] else '') + ' (Results → Your answers)'}
    for name, render in gate_text.items():
        lines += [f"  {render(item)}" for item in gates[name]]
    if not any(gates.values()):
        lines.append('  none')
    lines.append('CHECKS (worth a look, nothing waits for them):')
    found = len(lines)
    if checks['auto_labels']:
        lines.append(f"  automatic labels not confirmed by you: cuts {numbers_text(item['cut'] for item in checks['auto_labels'])}")
    if checks['no_boxes']:
        lines.append(f"  detected without any box (mark No characters if right): cuts {numbers_text(checks['no_boxes'])}")
    for item in checks['stale_results']:
        lines.append(f"  cut {item['cut']}: {item['title'] or 'result'} is stale ({item['reason']})")
    for item in checks['picture_contradictions']:
        lines += [f"  cut {item['cut']}: picture {check['picture']} contradicts \"{check['claim']}\" ({check['character']})" for check in item['checks']]
    if checks['lines_to_check']['count']:
        lines.append(f"  {checks['lines_to_check']['count']} transcript line(s) with a medium/low speaker confidence (Audio → Lines to check)")
    for item in checks['sequences_unconfirmed']:
        lines.append(f"  sequence {item['title'] or item['id']}: dialogue not confirmed")
    for key, label in (('speaker_attribution_stale', 'speaker attribution'), ('transcript_stale', 'transcript')):
        if checks.get(key):
            lines.append(f"  {label} is stale: {checks[key]}")
    if len(lines) == found:
        lines.append('  none')
    if report['failures']:
        lines.append(f"FAILED RUNS: {len(report['failures'])} (fw failures)")
    lines.append(f"ui: {ui_link(api, episode)}")
    return '\n'.join(lines)


def cmd_review(api, args):
    episode = find_episode(api, args.episode, args.latest)
    report = review(api, episode['id'], parse_range(args.range))
    emit(args, report, review_text(api, episode, report))
    gates = report['gates']
    return BLOCKED if any(gates.values()) else OK


def cmd_cut(api, args):
    episode = find_episode(api, args.episode, args.latest)
    if not args.number or not args.number.isdigit():
        raise Failure('give the cut number as shown in the editor, for example: fw cut EP 12')
    number = int(args.number)
    found = in_range(cuts(api, episode['id']), (number, number))
    if not found:
        raise Failure(f'there is no active cut {number}')
    cut = found[0]
    report = review(api, episode['id'], (number, number))
    missing = [name.replace('_missing', '') for name, numbers in report['progress'].items() if isinstance(numbers, list) and number in numbers]
    text = '\n'.join([f"cut {number}  {cut['id']}  {cut['start_time']:.3f}-{cut['end_time']:.3f}s  analysis {'on' if cut['analysis_enabled'] else 'off'}",
                      f"missing: {', '.join(missing) or 'nothing'}", review_text(api, episode, report)])
    emit(args, {'cut': cut, 'review': report}, text)
    return OK


def cmd_retry(api, args):
    result = api.post(f'/api/jobs/{quote(args.job)}/retry')
    emit(args, result, f"retried {args.job}" + (f" as {', '.join(job_ids(result))}" if job_ids(result) else ''))
    return OK


def cmd_dismiss(api, args):
    emit(args, api.post(f'/api/jobs/{quote(args.job)}/dismiss'), f'dismissed {args.job}')
    return OK


def cmd_cancel(api, args):
    episode = find_episode(api, args.episode, args.latest)
    result = api.post(f"/api/episodes/{episode['id']}/queue/cancel", body={'include_running': args.running, 'group': args.group})
    emit(args, result, f"cancelled {result.get('cancelled', 0)} job(s)")
    return OK


# --- command line ------------------------------------------------------------------------------------------------

def parser():
    root = argparse.ArgumentParser(prog='fw', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument('--json', action='store_true', help='print the full response as JSON')
    common.add_argument('--url', help=f'server (default {base_url()})')
    common.add_argument('--dry-run', action='store_true', help='print the requests that would change something, send none')
    sub = root.add_subparsers(dest='command', required=True, metavar='COMMAND')

    def episode_command(name, func, help_text, rng=False):
        command = sub.add_parser(name, parents=[common], help=help_text, description=help_text)
        command.add_argument('episode', nargs='?', help='episode id, or text of "Project / Episode"')
        command.add_argument('--latest', action='store_true', help='the newest episode')
        if rng:
            command.add_argument('range', nargs='?', default='all', help='cuts: 100-120, 7, 5-, -10 or all (default)')
        command.set_defaults(func=func)
        return command

    for name, (_, help_text) in STEPS.items():
        command = episode_command(name, cmd_step, help_text, rng=True)
        command.set_defaults(step=name)
        command.add_argument('--redo', action='store_true', help='also cuts that already have it (where the step supports it)')
        command.add_argument('--save', action='store_true', help='answers: save the drafts as your answers instead of suggestions')
        command.add_argument('--language', help='subtitle language for setup/subtitles (default: the episode setting)')
        command.add_argument('--replace-manual', action='store_true', help='transcribe: also replace lines you edited by hand')

    sub.add_parser('health', parents=[common], help='is the server up').set_defaults(func=cmd_health)
    command = sub.add_parser('episodes', parents=[common], help='list episodes')
    command.add_argument('project', nargs='?', help='only projects whose title contains this')
    command.set_defaults(func=cmd_episodes)
    episode_command('status', cmd_status, 'setup, progress, checkpoints, queue and failures in a few lines')
    episode_command('queue', cmd_queue, 'what runs and waits now')
    episode_command('failures', cmd_failures, 'failed runs that wait for a decision, with their errors')
    episode_command('review', cmd_review, 'what waits for a person (exit 2 when a checkpoint is open)', rng=True)
    command = episode_command('cut', cmd_cut, 'one cut: what it is missing and what waits for a person')
    command.add_argument('number', nargs='?', help='cut number as shown in the editor')
    for name, func, help_text in (('next', cmd_next, 'the next step of the gated flow (exit 2 blocked, 3 busy)'),
                                  ('drive', cmd_drive, 'repeat next and wait until a person is needed or all is done')):
        command = episode_command(name, func, help_text)
        command.add_argument('--language', help='subtitle language when setup still needs it')
        if name == 'next':
            command.add_argument('--go', action='store_true', help='queue it (otherwise only print it)')
    command = episode_command('wait', cmd_wait, 'wait until the episode queue is empty, or until --jobs finish')
    command.add_argument('--jobs', help='comma-separated job ids to wait for instead of the whole queue')
    command.add_argument('--timeout', type=float, default=0, help='give up after this many seconds (exit 3); 0 waits forever')
    for name, func, help_text in (('retry', cmd_retry, 'run a failed job again'), ('dismiss', cmd_dismiss, 'stop listing a failed job')):
        command = sub.add_parser(name, parents=[common], help=help_text)
        command.add_argument('job')
        command.set_defaults(func=func)
    command = episode_command('cancel', cmd_cancel, "cancel the episode's queued jobs")
    command.add_argument('--group', help='only this waiting group (see fw queue)')
    command.add_argument('--running', action='store_true', help='also stop running jobs at their next checkpoint')
    return root


def main(argv=None):
    args = parser().parse_args(argv)
    if getattr(args, 'latest', False) and args.episode:
        # `fw boxes --latest 100-120` / `fw cut --latest 7`: the first positional is the range or the cut number
        if getattr(args, 'range', None) == 'all':
            args.range, args.episode = args.episode, None
        elif hasattr(args, 'number') and args.number is None:
            args.number, args.episode = args.episode, None
    api = Api(args.url.rstrip('/') if getattr(args, 'url', None) else base_url(), dry_run=getattr(args, 'dry_run', False))
    try:
        return args.func(api, args)
    except Failure as exc:
        print(f'error: {exc}', file=sys.stderr)
        return ERROR
    except KeyboardInterrupt:
        return ERROR


if __name__ == '__main__':
    sys.exit(main())
