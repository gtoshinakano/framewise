#!/usr/bin/env python3
"""Drive Framewise from a terminal or an agent: queue steps over cut ranges, wait for the queue, list what needs a person.

    scripts/fw episodes                          # find an episode (id, or "Project / Episode" text)
    scripts/fw boxes "Episode 6" 100-120         # first-frame boxes for cuts 100..120
    scripts/fw visual "Episode 6" 5-10           # visual analysis (keyframes and beats follow)
    scripts/fw summary "Episode 6" all --redo    # write every Cut summary again
    scripts/fw wait "Episode 6" --jobs ID,ID     # until those jobs finish
    scripts/fw review "Episode 6"                # what waits for a person
    scripts/fw next "Episode 6" --go             # queue the next step of the gated flow
    scripts/fw drive "Episode 6"                 # repeat next/wait until a person is needed
    scripts/fw analysis "Episode 6" 100-200      # what every cut still needs, per step, with --links the cut URLs
    scripts/fw links "Episode 6" 199,204 --place target-frames   # one URL per cut, opening the place that needs it
    scripts/fw agent start "Episode 6" --agent claude-code --purpose "line splits"   # an autopilot run (prints its id)
    scripts/fw inbox "Episode 6"                 # what agents escalated to a person, and what they applied
    scripts/fw agent undo RUN_ID                 # undo everything a run applied (what a person changed since stays)
    scripts/fw diagnose "Episode 6" 100-200      # per cut, what is wrong and why, worst cuts first, with links
    scripts/fw why "Episode 6" 142 --step summary  # the chain of prerequisites down to the first broken one
    scripts/fw triage "Episode 6" --go --run RUN_ID  # apply the fix rules to failed runs (logged, undoable)
    scripts/fw missed-cuts check "Episode 6"     # find hard cuts the detection missed; split the sure ones, ask about the rest
    scripts/fw missed-cuts report "Episode 6"    # what it split (undo ids) and the open questions with their pictures
    scripts/fw line-splits "Episode 6"           # what the line splitter would do with lines across hard cuts; add run to apply it

Cut numbers are the editor's (1-based). RANGE is 100-120, 100..120, 7, 5- (to the end), -10 or all (the default).
Only the HTTP API is used: FRAMEWISE_URL, else http://chopper.local:8080 (the server). It runs the same from any machine
on the LAN, and nothing on the machine it runs from needs rebuilding or restarting.
It queues, waits, retries, dismisses, cancels and reads. It never edits labels, boxes, transcript text, answers,
dialogue or sequences, and never restarts containers.

Exit codes: 0 ok or done, 1 error, 2 blocked on a person, 3 busy (work is queued or running).
"""
import argparse
import json
import math
import os
import re
import sys
import time
from urllib.error import HTTPError, URLError
from urllib.parse import quote, urlencode
from urllib.request import Request, urlopen

OK, ERROR, BLOCKED, BUSY = 0, 1, 2, 3
DEFAULT_URL = 'http://chopper.local:8080'
POLL_SECONDS = 15
# speaker_attribution leaves this reason itself when some windows went unanswered; running it again would not settle it.
UNANSWERED_ATTRIBUTION = 'Some lines could not be attributed'
FINISHED = ('done', 'failed', 'cancelled')


class Failure(Exception):
    pass


def base_url():
    return (os.environ.get('FRAMEWISE_URL') or DEFAULT_URL).rstrip('/')


class Api:
    def __init__(self, url, dry_run=False):
        self.url, self.dry_run = url, dry_run

    def call(self, method, path, params=None, body=None):
        query = urlencode({key: str(value).lower() if isinstance(value, bool) else value
                           for key, value in (params or {}).items() if value is not None})
        url = f'{self.url}{path}' + (f'?{query}' if query else '')
        if self.dry_run and method != 'GET':
            print(f'dry run: {method} {url}' + (f' {json.dumps(body)}' if body is not None else ''))
            return {'dry_run': True, 'job_ids': []}
        data = json.dumps(body).encode() if body is not None else (b'' if method != 'GET' else None)
        headers = {'Content-Type': 'application/json'} if body is not None else {}
        try:
            with urlopen(Request(url, data=data, method=method, headers=headers), timeout=120) as response:
                raw = response.read()
        except HTTPError as exc:
            detail = exc.read().decode(errors='replace')
            try:
                detail = json.loads(detail).get('detail', detail)
            except (ValueError, AttributeError):
                pass
            raise Failure(f'{method} {path}: HTTP {exc.code}: {detail}') from None
        except (URLError, TimeoutError) as exc:
            raise Failure(f'cannot reach {self.url}: {getattr(exc, "reason", exc)}') from None
        return json.loads(raw) if raw else {}

    def get(self, path, params=None):
        return self.call('GET', path, params)

    def raw(self, path, params=None):
        """The body of a GET as bytes (an image)."""
        query = urlencode({key: value for key, value in (params or {}).items() if value is not None})
        try:
            with urlopen(Request(f'{self.url}{path}' + (f'?{query}' if query else '')), timeout=120) as response:
                return response.read()
        except HTTPError as exc:
            raise Failure(f'GET {path}: HTTP {exc.code}: {exc.read().decode(errors="replace")[:300]}') from None
        except (URLError, TimeoutError) as exc:
            raise Failure(f'cannot reach {self.url}: {getattr(exc, "reason", exc)}') from None

    def post(self, path, params=None, body=None):
        return self.call('POST', path, params, body)


# --- small helpers -----------------------------------------------------------------------------------------------

def parse_range(text):
    """'100-120' -> (100, 120); '7' -> (7, 7); '5-' -> (5, None); '-10' -> (None, 10); 'all' -> (None, None)."""
    text = (text or 'all').strip().lower()
    if text in ('all', '*', ''):
        return None, None
    if text.isdigit():
        return int(text), int(text)
    match = re.fullmatch(r'(\d+)?\s*(?:-|\.\.|to)\s*(\d+)?', text)
    if not match or not any(match.groups()):
        raise Failure(f'cannot read the cut range {text!r}: use 100-120, 7, 5-, -10 or all')
    first, last = (int(value) if value else None for value in match.groups())
    if (first is not None and first < 1) or (last is not None and last < 1):
        raise Failure('cut numbers start at 1')
    if first is not None and last is not None and last < first:
        raise Failure(f'the range {text!r} ends before it starts')
    return first, last


def range_text(span):
    first, last = span
    if first is None and last is None:
        return 'all cuts'
    if first == last:
        return f'cut {first}'
    return f"cuts {first or 1}-{last if last is not None else 'end'}"


def numbers_text(numbers, limit=12):
    """[1,2,3,5,9,10] -> '1-3, 5, 9-10'."""
    spans, numbers = [], sorted(set(numbers))
    for number in numbers:
        if spans and number == spans[-1][1] + 1:
            spans[-1][1] = number
        else:
            spans.append([number, number])
    parts = [f'{a}' if a == b else f'{a}-{b}' for a, b in spans]
    return ', '.join(parts[:limit]) + (f', … ({len(numbers)} cuts)' if len(parts) > limit else '')


def emit(args, data, text):
    if args.json:
        print(json.dumps(data, indent=1, ensure_ascii=False))
    elif text:
        print(text)


# --- episodes and cuts -------------------------------------------------------------------------------------------

def all_episodes(api):
    return [{**episode, 'project_id': project['id'], 'project': project['title']}
            for project in api.get('/api/projects') for episode in project.get('episodes', [])]


def match_episodes(episodes, ref):
    """Episodes named by ``ref``: an id, an exact title, or text found in "Project / Episode" (both sides with a slash)."""
    needle = ref.strip().lower()
    by_id = [episode for episode in episodes if episode['id'].lower() == needle or episode['id'].lower().startswith(needle) and len(needle) >= 8]
    if by_id:
        return by_id
    exact = [episode for episode in episodes if episode['title'].lower() == needle or f"{episode['project']} / {episode['title']}".lower() == needle]
    if exact:
        return exact
    if '/' in needle:
        project, _, title = (part.strip() for part in needle.rpartition('/'))
        found = [episode for episode in episodes if project in episode['project'].lower() and title in episode['title'].lower()]
        # "Show / Episode 1" means Episode 1, not Episode 10
        return [episode for episode in found if episode['title'].lower() == title] or found
    return [episode for episode in episodes if needle in f"{episode['project']} / {episode['title']}".lower()]


def find_episode(api, ref, latest=False):
    episodes = all_episodes(api)
    if latest:
        if not episodes:
            raise Failure('there are no episodes')
        return max(episodes, key=lambda episode: episode['created_at'])
    if not ref:
        raise Failure('name an episode: its id, "Project / Episode" text, or --latest')
    found = match_episodes(episodes, ref)
    if len(found) == 1:
        return found[0]
    if not found:
        raise Failure(f'no episode matches {ref!r}; list them with: fw episodes')
    listing = '\n'.join(f"  {episode['id']}  {episode['project']} / {episode['title']}" for episode in found)
    raise Failure(f'{ref!r} matches {len(found)} episodes; use the id or a longer name:\n{listing}')


def cuts(api, episode_id):
    items, offset = [], 0
    while offset is not None:
        page = api.get(f'/api/v1/episodes/{episode_id}/cuts', {'offset': offset, 'limit': 500})
        items += page['items']
        offset = page.get('next_offset')
    return items


def in_range(items, span):
    first, last = span
    return [cut for cut in items if (first or 1) <= cut['cut_index'] + 1 <= (last if last is not None else math.inf)]


def review(api, episode_id, span=(None, None)):
    try:
        return api.get(f'/api/episodes/{episode_id}/review', {'from_cut': span[0], 'to_cut': span[1]})
    except Failure as exc:
        if 'HTTP 404' in str(exc) and 'Episode not found' not in str(exc):
            raise Failure('the server has no /review endpoint yet: rebuild and restart video-analyzer on the host') from None
        raise


def queue(api, episode_id):
    return api.get(f'/api/episodes/{episode_id}/queue')


def ui_link(api, episode):
    return f"{api.url}/#/episode/{episode['id']}"


# Where a cut link lands (frontend/src/cutRoute.ts). `cut` only selects the cut; the others open the Analysis dialog.
PLACES = {'cut': '', 'analysis': '/analysis', 'run': '/analysis/run', 'characters': '/analysis/characters',
          'target-frames': '/analysis/target-frames', 'assistant': '/analysis/assistant'}
LINK_LIMIT = 25


def cut_url(api, episode, cut_id, place='cut'):
    """The address of one cut (cut ids never change): ``http://host:8080/#/episode/E/cut/C[/analysis[/place]]``."""
    if place not in PLACES:
        raise Failure(f"unknown place {place!r}: use {', '.join(PLACES)}")
    return f"{api.url}/#/episode/{episode['id']}/cut/{cut_id}{PLACES[place]}"


def cut_numbers(api, episode):
    """{editor cut number: v1 cut} of the episode's active cuts, read once per fw run."""
    cache = api.__dict__.setdefault('_cut_numbers', {})
    if episode['id'] not in cache:
        cache[episode['id']] = {cut['cut_index'] + 1: cut for cut in cuts(api, episode['id'])}
    return cache[episode['id']]


def url_for_number(api, episode, number, place='cut'):
    cut = cut_numbers(api, episode).get(number)
    return cut_url(api, episode, cut['id'], place) if cut else None


def url_at_time(api, episode, seconds, place='analysis'):
    """The cut that covers ``seconds`` of the episode (for things that belong to the audio, such as an unknown voice)."""
    for cut in cut_numbers(api, episode).values():
        if cut['start_time'] <= seconds < cut['end_time']:
            return cut_url(api, episode, cut['id'], place)
    return None


def link_lines(api, episode, numbers, place, indent='  '):
    """`- cut N: URL` for each number (at most LINK_LIMIT; `fw links` prints the rest)."""
    numbers = sorted(set(numbers))
    lines = [f"{indent}- cut {number}: {url_for_number(api, episode, number, place) or '(cut not found)'}" for number in numbers[:LINK_LIMIT]]
    if len(numbers) > LINK_LIMIT:
        lines.append(f"{indent}… {len(numbers) - LINK_LIMIT} more cuts: fw links EP {numbers_text(numbers[LINK_LIMIT:], limit=10**6).replace(', ', ',')} --place {place}")
    return lines


# --- steps -------------------------------------------------------------------------------------------------------

def job_ids(result):
    ids = list(result.get('job_ids') or [])
    if result.get('job_id'):
        ids.append(result['job_id'])
    return ids


def batch(path, **choices):
    """An episode endpoint that takes from_cut/to_cut. ``choices`` map query names to functions of the parsed arguments."""
    def run(api, episode, span, args):
        params = {'from_cut': span[0], 'to_cut': span[1], **{name: pick(args) for name, pick in choices.items()}}
        return api.post(path.format(id=episode['id']), params)
    return run


def per_cut(path, body=None):
    """One request per enabled cut in the range, for steps whose work is per cut anyway."""
    def run(api, episode, span, args):
        selected = in_range(cuts(api, episode['id']), span)
        ids, skipped, errors = [], [], []
        for cut in selected:
            number = cut['cut_index'] + 1
            if not cut['analysis_enabled']:
                skipped.append(number)
                continue
            try:
                ids += job_ids(api.post(path.format(cut=cut['id']), body=body))
            except Failure as exc:
                errors.append({'cut': number, 'error': str(exc)})
        return {'queued': len(ids), 'job_ids': ids, 'skipped_disabled': skipped, 'errors': errors, 'dry_run': api.dry_run}
    return run


def whole(make):
    """A step that works on the whole episode."""
    def run(api, episode, span, args):
        if span != (None, None):
            raise Failure('this step works on the whole episode; leave out the cut range')
        return make(api, episode, args)
    return run


def language_for(api, episode, args):
    language = args.language or review(api, episode['id'])['episode'].get('subtitle_language')
    if not language:
        raise Failure('state the subtitle language with --language (for example --language Japanese)')
    return language


def transcribe(api, episode, span, args):
    if span == (None, None):
        return api.post(f"/api/episodes/{episode['id']}/transcribe")
    selected = in_range(cuts(api, episode['id']), span)
    if not selected:
        raise Failure(f'no active cut in {range_text(span)}')
    body = {'start_time': selected[0]['start_time'], 'end_time': selected[-1]['end_time'], 'replace_manual': args.replace_manual}
    return api.post(f"/api/episodes/{episode['id']}/transcribe-range", body=body)


not_redo = lambda args: not args.redo  # noqa: E731

STEPS = {
    'setup': (whole(lambda api, episode, args: api.post(f"/api/episodes/{episode['id']}/prepare", body={'language': language_for(api, episode, args)})),
              'media, cut detection, transcription, subtitles, boxes and recognition (skips what is done)'),
    'boxes': (batch('/api/episodes/{id}/character-boxes'), 'first-frame boxes for cuts without a current detection'),
    'recognize': (lambda api, episode, span, args: batch('/api/episodes/{id}/character-detection-rerun' if args.redo
                                                         else '/api/episodes/{id}/character-detection')(api, episode, span, args),
                  'name the boxes from the gallery; --redo replaces automatic labels (manual labels stay)'),
    'characters': (batch('/api/episodes/{id}/character-detection-all'), 'boxes and recognition in one pass'),
    'target-frames': (batch('/api/episodes/{id}/target-detection', only_missing=not_redo), 'people on the evaluated frames'),
    'keyframes': (per_cut('/api/cuts/{cut}/keyframe-selection', body={}), 'keyframe selection (visual queues it when needed)'),
    'visual': (batch('/api/episodes/{id}/visual-analysis', only_missing=not_redo), 'first frame and keyframe analysis; beats follow'),
    'beats': (per_cut('/api/cuts/{cut}/performance-beats'), 'performance beats from the current keyframes'),
    'consistency': (batch('/api/episodes/{id}/consistency-summaries', only_missing=not_redo), 'the consistency review'),
    'answers': (batch('/api/episodes/{id}/review-answers', auto_save=lambda args: args.save),
                "draft answers to the review's questions; kept as suggestions unless --save"),
    'summary': (batch('/api/episodes/{id}/cut-summaries', only_missing=not_redo), 'Cut summaries; --redo writes them again'),
    'text-chain': (batch('/api/episodes/{id}/text-chain', only_missing=not_redo), 'review, auto-saved answers and Cut summary unattended'),
    'transcribe': (transcribe, 'transcribe again (a range re-transcribes from the first cut start to the last cut end)'),
    'subtitles': (whole(lambda api, episode, args: api.post(f"/api/episodes/{episode['id']}/subtitles", body={'language': language_for(api, episode, args)})),
                  'read the burned-in subtitles'),
    'speakers': (whole(lambda api, episode, args: api.post(f"/api/episodes/{episode['id']}/speaker-attribution")), 'speaker attribution'),
}

# Checkpoints that should be settled before a step, so an explicit request can warn about them.
UPSTREAM = {'target-frames': ('first_frame',), 'keyframes': ('first_frame',), 'visual': ('first_frame', 'target_frames'),
            'beats': ('first_frame', 'target_frames'), 'consistency': ('first_frame', 'target_frames', 'voices'),
            'answers': ('first_frame', 'target_frames', 'voices'), 'text-chain': ('first_frame', 'target_frames', 'voices'),
            'summary': ('decisions',)}


def gate_lines(report, names):
    gates, lines = report['gates'], []
    for name in names:
        items = gates.get(name) or []
        if not items:
            continue
        if name == 'voices':
            voices = [f"{voice['speaker_label'] or '(no label)'} ({voice['lines']} lines)" for voice in items[:6]]
            lines.append('unknown voices: ' + ', '.join(voices))
        else:
            label = {'first_frame': 'unlabeled first-frame boxes', 'target_frames': 'target frames to review',
                     'decisions': 'review questions without saved answers'}[name]
            lines.append(f"{label}: cuts {numbers_text(item['cut'] for item in items)}")
    return lines


GATE_PLACES = {'first_frame': 'characters', 'target_frames': 'target-frames', 'decisions': 'analysis'}


def gate_links(api, episode, report, names):
    """The cut URLs behind ``gate_lines``: one `- cut N: URL` per cut, under the heading of its checkpoint."""
    lines = []
    for name in names:
        items = report['gates'].get(name) or []
        if not items:
            continue
        if name == 'voices':
            lines += ['  unknown voices (Results → Spoken words → Unknown voices):']
            lines += [f"  - {voice['speaker_label'] or '(no label)'}: {url_at_time(api, episode, voice['first_time']) or episode_link(api, episode)}" for voice in items[:LINK_LIMIT]]
        else:
            lines += [f"  {GATE_HEADINGS[name]}:"] + link_lines(api, episode, [item['cut'] for item in items], GATE_PLACES[name])
    return lines


def episode_link(api, episode):
    return ui_link(api, episode)


GATE_HEADINGS = {'first_frame': 'first-frame boxes without a character (Characters panel)',
                 'target_frames': 'target frames to review (Target frames tab)',
                 'decisions': 'review questions without saved answers (Results → Your answers)'}


def blocked_links(api, episode, decision):
    gate = decision.get('gate')
    if decision.get('action') != 'blocked' or not decision.get('items'):
        return []
    if gate in GATE_PLACES or gate == 'voices':
        return gate_links(api, episode, {'gates': {gate: decision['items']}}, (gate,))
    if gate == 'failures':
        return [f"  - {item['label']}: {url}" for item in decision['items'] for span in [item.get('cut_span')]
                if span for url in [url_for_number(api, episode, span['first'])] if url]
    return []


def describe_result(step, span, result):
    if result.get('dry_run'):
        return ''
    ids = job_ids(result)
    parts = [f"{step} ({range_text(span)}): " + (f"queued {len(ids)} job(s)" if ids else 'nothing queued')]
    if result.get('deferred'):
        parts.append('deferred until cut detection finishes')
    skipped = result.get('skipped')
    if isinstance(skipped, int) and skipped:
        parts.append(f'skipped {skipped} cut(s) that already have it')
    for reason, numbers in (skipped if isinstance(skipped, dict) else {}).items():
        if numbers:
            parts.append(f"skipped ({reason.replace('_', ' ')}): cuts {numbers_text(numbers)}")
    if result.get('skipped_disabled'):
        parts.append(f"skipped (analysis off): cuts {numbers_text(result['skipped_disabled'])}")
    for reason, numbers in (result.get('blocked') or {}).items():
        if numbers:
            parts.append(f"not ready ({reason.replace('_', ' ')}): cuts {numbers_text(numbers)}")
    for error in result.get('errors') or []:
        parts.append(f"cut {error['cut']}: {error['error']}")
    if ids:
        parts.append('jobs: ' + ','.join(ids))
    return '\n'.join(parts)


def run_step(api, episode, step, span, args):
    return STEPS[step][0](api, episode, span, args)


def cmd_step(api, args):
    episode = find_episode(api, args.episode, args.latest)
    span = parse_range(args.range)
    try:
        report = review(api, episode['id'], span)
    except Failure as exc:
        if span != (None, None) and 'no /review endpoint' in str(exc):
            # A server without the review report predates to_cut: it would quietly queue the cuts after the range too.
            raise Failure('this server does not understand cut ranges yet: rebuild and restart video-analyzer on the host first') from None
        report = None
    warnings = gate_lines(report, UPSTREAM[args.step]) if report and args.step in UPSTREAM else []
    result = run_step(api, episode, args.step, span, args)
    text = describe_result(args.step, span, result)
    if warnings:
        text += '\nwarning: open checkpoints in this range (queued anyway because you asked):\n  ' + '\n  '.join(warnings)
        text += '\n' + '\n'.join(gate_links(api, episode, report, UPSTREAM[args.step]))
    emit(args, {'step': args.step, 'range': span, 'result': result, 'warnings': warnings}, text)
    return ERROR if result.get('errors') and not job_ids(result) else OK


# --- the gated flow ----------------------------------------------------------------------------------------------

def plan(report, queue_state, language=None):
    """The next move of the automatic flow: {'action': 'busy'|'run'|'blocked'|'done', ...}.

    Order: setup → speaker attribution → [first-frame names] → target frames → [target frame review] → visual
    analysis → beats → [unknown voices] → consistency review → suggested answers → [your answers] → Cut summaries.
    Bracketed steps are checkpoints for a person. Stale results are listed, never re-run: that is the user's call.
    """
    running = queue_state.get('running') or []
    if running or queue_state.get('waiting_total'):
        labels = [f"{run['label']} ({run['status']})" for run in running][:3]
        return {'action': 'busy', 'detail': f"running: {', '.join(labels) or 'none'}; waiting: {queue_state.get('waiting_total', 0)}"}
    if report['failures']:
        return {'action': 'blocked', 'gate': 'failures', 'items': report['failures'],
                'detail': f"{len(report['failures'])} failed run(s) need a decision: fw failures, then fw retry ID or fw dismiss ID"}
    setup, progress, gates, checks = report['setup'], report['progress'], report['gates'], report['checks']
    if not all(setup.values()):
        language = language or report['episode'].get('subtitle_language')
        missing = [name for name, done in setup.items() if not done]
        if not language:
            return {'action': 'blocked', 'gate': 'language', 'detail': f"setup needs the subtitle language ({', '.join(missing)} missing): add --language"}
        return {'action': 'run', 'step': 'setup', 'language': language, 'detail': f"missing: {', '.join(missing)}"}
    stale = checks.get('speaker_attribution_stale')
    if stale and stale != UNANSWERED_ATTRIBUTION:
        return {'action': 'run', 'step': 'speakers', 'detail': f'speaker attribution is stale: {stale}'}
    def run(step, numbers):
        return {'action': 'run', 'step': step, 'cuts': numbers, 'detail': f'cuts {numbers_text(numbers)}'}

    def blocked(gate):
        return {'action': 'blocked', 'gate': gate, 'items': gates[gate], 'detail': '; '.join(gate_lines(report, (gate,)))}

    if gates['first_frame']:
        return blocked('first_frame')
    if progress['target_missing']:
        return run('target-frames', progress['target_missing'])
    if gates['target_frames']:
        return blocked('target_frames')
    if progress['visual_missing']:
        return run('visual', progress['visual_missing'])
    if progress['beats_missing']:
        return run('beats', progress['beats_missing'])
    if gates['voices']:
        return blocked('voices')
    if progress['consistency_missing']:
        return run('consistency', progress['consistency_missing'])
    if drafts := [item['cut'] for item in gates['decisions'] if not item['draft']]:
        return {**run('answers', drafts), 'detail': f'suggested answers for cuts {numbers_text(drafts)}'}
    if gates['decisions']:
        return blocked('decisions')
    if progress['summary_missing']:
        return run('summary', progress['summary_missing'])
    return {'action': 'done', 'detail': 'nothing left for the automatic flow'}


def execute(api, episode, decision, args):
    """Queue what ``plan`` chose. Steps limited to some cuts go per cut or as the smallest covering range."""
    step = decision['step']
    numbers = decision.get('cuts') or []
    if step == 'setup':
        return api.post(f"/api/episodes/{episode['id']}/prepare", body={'language': decision['language']})
    if step == 'speakers':
        return api.post(f"/api/episodes/{episode['id']}/speaker-attribution")
    if step in ('beats', 'answers'):
        # per cut: the episode endpoints would also redo cuts that already have them
        path = '/api/cuts/{cut}/performance-beats' if step == 'beats' else '/api/cuts/{cut}/review-answers'
        wanted = set(numbers)
        ids, errors = [], []
        for cut in cuts(api, episode['id']):
            if cut['cut_index'] + 1 in wanted:
                try:
                    ids += job_ids(api.post(path.format(cut=cut['id'])))
                except Failure as exc:
                    errors.append({'cut': cut['cut_index'] + 1, 'error': str(exc)})
        return {'queued': len(ids), 'job_ids': ids, 'errors': errors}
    span = (min(numbers), max(numbers)) if numbers else (None, None)
    flags = argparse.Namespace(redo=False, save=False, language=None, replace_manual=False)
    return run_step(api, episode, step, span, flags)


def summary_line(decision):
    action = decision['action']
    if action == 'run':
        return f"next: {decision['step']} · {decision.get('detail', '')}"
    if action == 'blocked':
        return f"blocked on a person ({decision['gate']}): {decision.get('detail', '')}"
    return f"{action}: {decision.get('detail', '')}"


def cmd_next(api, args):
    episode = find_episode(api, args.episode, args.latest)
    decision = plan(review(api, episode['id']), queue(api, episode['id']), args.language)
    text = summary_line(decision)
    if decision['action'] == 'run' and args.go:
        result = execute(api, episode, decision, args)
        decision['result'] = result
        text += '\n' + describe_result(decision['step'], (min(decision['cuts']), max(decision['cuts'])) if decision.get('cuts') else (None, None), result)
    elif decision['action'] == 'run':
        text += '\n(add --go to queue it)'
    if decision['action'] in ('blocked', 'done'):
        links = blocked_links(api, episode, decision)
        text += ('\n' + '\n'.join(links) if links else '') + f'\nopen the episode: {ui_link(api, episode)}'
    emit(args, decision, text)
    return {'run': OK, 'done': OK, 'blocked': BLOCKED, 'busy': BUSY}[decision['action']]


def wait_queue(api, episode_id, timeout, quiet=False):
    """Poll until the episode has nothing queued or running. True when idle, False on timeout."""
    deadline, last = time.time() + timeout if timeout else math.inf, None
    while True:
        state = queue(api, episode_id)
        running = state.get('running') or []
        line = ' · '.join([f"{run['label']}: {run['stage']}" + (f" ({run['units']['done']}/{run['units']['total']})" if run['units']['total'] else '')
                           for run in running[:3]] + [f"waiting {state.get('waiting_total', 0)}"])
        if not running and not state.get('waiting_total'):
            return True
        if line != last and not quiet:
            print(time.strftime('%H:%M:%S'), line, flush=True)
            last = line
        if time.time() >= deadline:
            return False
        time.sleep(POLL_SECONDS)


def wait_jobs(api, ids, timeout):
    deadline, last = time.time() + timeout if timeout else math.inf, {}
    while True:
        states = {job_id: api.get(f'/api/v1/jobs/{quote(job_id)}') for job_id in ids}
        for job_id, job in states.items():
            key = (job['status'], job['stage'])
            if last.get(job_id) != key:
                print(time.strftime('%H:%M:%S'), f"{job['pipeline']} {job_id[:8]}: {job['status']} · {job['stage']}", flush=True)
                last[job_id] = key
        if all(job['status'] in FINISHED for job in states.values()):
            failed = [job for job in states.values() if job['status'] == 'failed']
            for job in failed:
                print(f"failed {job['id']}: {(job['error'] or '')[:300]}")
            return ERROR if failed else OK
        if time.time() >= deadline:
            return BUSY
        time.sleep(POLL_SECONDS)


def cmd_wait(api, args):
    if args.jobs:
        return wait_jobs(api, [job.strip() for job in args.jobs.split(',') if job.strip()], args.timeout)
    episode = find_episode(api, args.episode, args.latest)
    if not wait_queue(api, episode['id'], args.timeout):
        print('still busy (timeout)')
        return BUSY
    failures = review(api, episode['id'])['failures']
    print('idle' + (f'; {len(failures)} failed run(s): fw failures' if failures else ''))
    return ERROR if failures else OK


def cmd_drive(api, args):
    """next --go, wait, again; stop when a person is needed, when done, or when a step makes no progress."""
    episode = find_episode(api, args.episode, args.latest)
    print(f"driving {episode['project']} / {episode['title']} ({episode['id']})", flush=True)
    previous = None
    while True:
        decision = plan(review(api, episode['id']), queue(api, episode['id']), args.language)
        if decision['action'] == 'busy':
            print(time.strftime('%H:%M:%S'), summary_line(decision), flush=True)
            wait_queue(api, episode['id'], 0)
            continue
        if decision['action'] != 'run':
            print(summary_line(decision))
            print('\n'.join(blocked_links(api, episode, decision)))
            print(f'open the episode: {ui_link(api, episode)}')
            return BLOCKED if decision['action'] == 'blocked' else OK
        key = (decision['step'], tuple(decision.get('cuts') or ()))
        if key == previous:
            print(f"stopped: {decision['step']} ran but the same cuts still need it ({decision.get('detail', '')}); check them by hand")
            return BLOCKED
        previous = key
        print(time.strftime('%H:%M:%S'), summary_line(decision), flush=True)
        result = execute(api, episode, decision, args)
        print(describe_result(decision['step'], (min(decision['cuts']), max(decision['cuts'])) if decision.get('cuts') else (None, None), result), flush=True)
        if not job_ids(result):
            print(f"stopped: {decision['step']} queued nothing; check those cuts by hand")
            return BLOCKED
        wait_queue(api, episode['id'], 0)


# --- reading -----------------------------------------------------------------------------------------------------

def cmd_health(api, args):
    emit(args, api.get('/api/health'), f'{api.url}: ok')
    return OK


def cmd_episodes(api, args):
    episodes = all_episodes(api)
    if args.project:
        needle = args.project.lower()
        episodes = [episode for episode in episodes if needle in episode['project'].lower() or episode['project_id'] == args.project]
    text = '\n'.join(f"{episode['id']}  {episode['project']} / {episode['title']}  ({episode['status']})" for episode in episodes)
    emit(args, episodes, text or 'no episodes')
    return OK


def status_text(api, episode, report, state):
    setup = ' '.join(f"{name} {'ok' if done else 'MISSING'}" for name, done in report['setup'].items())
    progress = report['progress']
    counts = ' · '.join(f"{name.replace('_', ' ')} {len(progress[name])}" for name in
                        ('boxes_missing', 'target_missing', 'visual_missing', 'beats_missing', 'consistency_missing', 'summary_missing'))
    gates = ' · '.join(f"{name.replace('_', ' ')} {len(items)}" for name, items in report['gates'].items())
    running = ', '.join(f"{run['label']} ({run['stage']})" for run in state.get('running') or []) or 'nothing'
    return '\n'.join([
        f"{episode['project']} / {episode['title']}  {episode['id']}",
        f"subtitle language: {report['episode'].get('subtitle_language') or 'not set'}",
        f"setup: {setup}",
        f"cuts: {progress['cuts']} active, {progress['enabled']} enabled · {counts}",
        f"waiting for a person: {gates}",
        f"queue: running {running}; waiting {state.get('waiting_total', 0)}",
        f"failures: {len(report['failures'])}" + (' (fw failures)' if report['failures'] else ''),
        f"ui: {ui_link(api, episode)}"])


def cmd_status(api, args):
    episode = find_episode(api, args.episode, args.latest)
    report, state = review(api, episode['id']), queue(api, episode['id'])
    emit(args, {'episode': episode, 'review': report, 'queue': state}, status_text(api, episode, report, state))
    return OK


def cmd_queue(api, args):
    episode = find_episode(api, args.episode, args.latest)
    state = queue(api, episode['id'])
    lines = [f"running: {run['label']} · {run['stage']} · {run['units']['done']}/{run['units']['total']} · {run['id']}" for run in state.get('running') or []]
    lines += [f"waiting: {group['count']} × {group['label']} (group {group['group']})" for group in state.get('waiting_groups') or []]
    if any((state.get('elsewhere') or {}).values()):
        lines.append(f"elsewhere on the GPU: {json.dumps(state['elsewhere'], ensure_ascii=False)[:200]}")
    lines.append(f"failed: {len(state.get('attention') or [])}")
    emit(args, state, '\n'.join(lines))
    return OK


def cmd_failures(api, args):
    episode = find_episode(api, args.episode, args.latest)
    items = review(api, episode['id'])['failures']
    text = '\n'.join(f"{item['id']}  {item['label']}" + (f" (cuts {item['cut_span']['first']}-{item['cut_span']['last']})" if item.get('cut_span') else '')
                     + f"  retry: {'yes' if item['retry'] else 'no'}\n    {item['error']}" for item in items) or 'no failures'
    emit(args, items, text)
    return OK


def review_text(api, episode, report):
    """The checklist for a person, one `- cut N: URL` line per cut so each can be opened straight away."""
    gates, checks = report['gates'], report['checks']
    where = f" · {range_text((report['range']['from_cut'], report['range']['to_cut']))}" if report.get('range') else ''
    lines = [f"{episode['project']} / {episode['title']}{where}"]

    def section(title, items):
        """items: [(cut number or None, detail, url)]; one `- cut N · detail: URL` line each."""
        if not items:
            return
        lines.append(title)
        for number, detail, url in items[:LINK_LIMIT * 2]:
            label = ' · '.join(part for part in (f'cut {number}' if number is not None else '', detail) if part)
            lines.append(f"  - {label}: {url or '(no link)'}")
        if len(items) > LINK_LIMIT * 2:
            lines.append(f'  … {len(items) - LINK_LIMIT * 2} more (fw review --json)')

    def rows(entries, place, detail):
        return [(item['cut'], detail(item), url_for_number(api, episode, item['cut'], place)) for item in entries]

    lines.append('THESE NEED A PERSON (the automatic flow waits for them):')
    start = len(lines)
    section('First-frame boxes without a character (Characters panel):', rows(gates['first_frame'], 'characters',
            lambda item: f"{item['unlabeled_boxes']} box(es)"))
    section('Target frames to review (Target frames tab):', rows(gates['target_frames'], 'target-frames', lambda item: ', '.join(
        [f"frame {frame['ordinal']} {'/'.join(frame['flags'])}" for frame in item['frames']]
        + ([f"{item['unnamed_people']} unnamed person(s)"] if item['unnamed_people'] else []))))
    section('Unknown voices (Results → Spoken words → Unknown voices; the link opens the cut of the first line):', [
        (None, f"voice {voice['speaker_label'] or '(no label)'} · {voice['lines']} line(s), first at {voice['first_time']}s",
         url_at_time(api, episode, voice['first_time'])) for voice in gates['voices']])
    section('Review questions to answer (Results → Your answers):', rows(gates['decisions'], 'analysis', lambda item: f"{item['questions']} question(s)"
            + (' (a suggested draft is ready)' if item['draft'] else '')))
    if len(lines) == start:
        lines.append('  none')
    lines.append('WORTH A LOOK (nothing waits for them):')
    start = len(lines)
    section('Automatic labels you have not confirmed (Characters panel):', rows(checks['auto_labels'], 'characters', lambda item: f"{item['labels']} label(s)"))
    section('Detected without any box (mark No characters if that is right):', [(number, '', url_for_number(api, episode, number, 'characters')) for number in checks['no_boxes']])
    section('Stale results (the reason is why they changed; running them again is your call):', rows(
        checks['stale_results'], 'analysis', lambda item: f"{item['title'] or 'result'} — {item['reason']}"))
    section('Places where the pictures contradict the stored analysis:', [
        (item['cut'], f"picture {check['picture']} contradicts \"{check['claim']}\" ({check['character']})", url_for_number(api, episode, item['cut'], 'analysis'))
        for item in checks['picture_contradictions'] for check in item['checks']])
    if checks['lines_to_check']['count']:
        lines.append(f"Transcript lines with a medium or low speaker confidence (Audio → Lines to check): {checks['lines_to_check']['count']}")
        lines += [f"  - {line['start_time']}s {line['speaker_label'] or ''}: {url_at_time(api, episode, line['start_time']) or '(no link)'}"
                  for line in checks['lines_to_check'].get('lines', [])[:LINK_LIMIT]]
    for item in checks['sequences_unconfirmed']:
        lines.append(f"Sequence {item['title'] or item['id']}: dialogue not confirmed (Sequences → Dialogue): {ui_link(api, episode)}")
    for key, label in (('speaker_attribution_stale', 'Speaker attribution'), ('transcript_stale', 'Transcript')):
        if checks.get(key):
            lines.append(f"{label} is stale: {checks[key]}")
    if len(lines) == start:
        lines.append('  none')
    if report['failures']:
        lines.append(f"FAILED RUNS ({len(report['failures'])}; fw failures, fw retry ID, fw dismiss ID):")
        for item in report['failures']:
            span = item.get('cut_span')
            url = url_for_number(api, episode, span['first'], 'cut') if span else None
            lines.append(f"  - {item['label']}" + (f" (cuts {span['first']}-{span['last']})" if span else '') + f": {item['error'][:120]}" + (f"\n    {url}" if url else ''))
    lines.append(f"episode: {ui_link(api, episode)}")
    return '\n'.join(lines)


def cmd_review(api, args):
    episode = find_episode(api, args.episode, args.latest)
    report = review(api, episode['id'], parse_range(args.range))
    emit(args, report, review_text(api, episode, report))
    gates = report['gates']
    return BLOCKED if any(gates.values()) else OK


def cmd_cut(api, args):
    episode = find_episode(api, args.episode, args.latest)
    if not args.number or not args.number.isdigit():
        raise Failure('give the cut number as shown in the editor, for example: fw cut EP 12')
    number = int(args.number)
    found = in_range(cuts(api, episode['id']), (number, number))
    if not found:
        raise Failure(f'there is no active cut {number}')
    cut = found[0]
    report = review(api, episode['id'], (number, number))
    missing = [name.replace('_missing', '').replace('_', ' ') for name, numbers in report['progress'].items()
               if name.endswith('_missing') and isinstance(numbers, list) and number in numbers]
    text = '\n'.join([f"cut {number}  {cut['id']}  {cut['start_time']:.3f}-{cut['end_time']:.3f}s  analysis {'on' if cut['analysis_enabled'] else 'off'}",
                      f"missing: {', '.join(missing) or 'nothing'}",
                      f"open: {cut_url(api, episode, cut['id'])}", f"results: {cut_url(api, episode, cut['id'], 'analysis')}", review_text(api, episode, report)])
    emit(args, {'cut': cut, 'review': report}, text)
    return OK


# What each progress list of the review report means: (key, what the cut needs, step that queues it, place of the link)
NEEDS = (('boxes_missing', 'first-frame character detection (boxes)', 'boxes', 'characters'),
         ('target_missing', 'target-frames people detection', 'target-frames', 'target-frames'),
         ('first_frame_missing', 'first-frame analysis', 'visual', 'run'),
         ('keyframes_missing', 'keyframe analysis', 'visual', 'run'),
         ('beats_missing', 'performance beats', 'beats', 'analysis'),
         ('consistency_missing', 'consistency review', 'consistency', 'analysis'),
         ('summary_missing', 'Cut summary', 'summary', 'analysis'))


def analysis_status(report):
    """The review report as a status: what each cut still needs (a step), what waits for a person, what is worth a look.

    ``steps`` and ``person`` are lists of {key, text, cuts, step/place}; ``look`` has plain {text, cuts} entries.
    A server older than first_frame_missing/keyframes_missing reports both as visual_missing.
    """
    progress, gates, checks = report['progress'], report['gates'], report['checks']
    steps = []
    split = 'first_frame_missing' in progress
    for key, text, step, place in NEEDS:
        if key in ('first_frame_missing', 'keyframes_missing') and not split:
            continue
        cuts_ = progress.get(key) or []
        if cuts_:
            steps.append({'key': key, 'text': f'Needs {text}', 'cuts': cuts_, 'step': step, 'place': place})
    if not split and progress.get('visual_missing'):
        steps.append({'key': 'visual_missing', 'text': 'Needs first-frame and keyframe analysis', 'cuts': progress['visual_missing'], 'step': 'visual', 'place': 'run'})
    person = []
    for key, text, place in (('first_frame', 'Needs character names on first-frame boxes', 'characters'),
                             ('target_frames', 'Needs target frames reviewed (flagged frames or unnamed people)', 'target-frames'),
                             ('decisions', 'Needs review questions answered', 'analysis')):
        if gates.get(key):
            person.append({'key': key, 'text': text, 'cuts': [item['cut'] for item in gates[key]], 'place': place})
    if gates.get('voices'):
        voices = ', '.join(f"{voice['speaker_label'] or '(no label)'} ({voice['lines']} lines)" for voice in gates['voices'])
        person.append({'key': 'voices', 'text': f'Needs unknown voices assigned to a character: {voices}', 'cuts': [], 'place': 'analysis',
                       'voices': gates['voices']})
    look = []
    for key, text, cuts_ in (
            ('auto_labels', 'Automatic labels you have not confirmed', [item['cut'] for item in checks.get('auto_labels') or []]),
            ('no_boxes', 'Detected without any box (mark No characters if that is right)', checks.get('no_boxes') or []),
            ('stale_results', 'Stale results (running them again is your call)', [item['cut'] for item in checks.get('stale_results') or []]),
            ('picture_contradictions', 'Pictures contradict the stored analysis', [item['cut'] for item in checks.get('picture_contradictions') or []])):
        if cuts_:
            look.append({'key': key, 'text': text, 'cuts': sorted(set(cuts_)),
                         'place': 'characters' if key in ('auto_labels', 'no_boxes') else 'analysis'})
    lines_to_check = (checks.get('lines_to_check') or {}).get('count')
    if lines_to_check:
        look.append({'key': 'lines_to_check', 'text': f'{lines_to_check} transcript line(s) with a medium or low speaker confidence (Audio → Lines to check)', 'cuts': []})
    for key, text in (('speaker_attribution_stale', 'Speaker attribution is stale'), ('transcript_stale', 'The transcript is stale')):
        if checks.get(key):
            look.append({'key': key, 'text': f'{text}: {checks[key]}', 'cuts': []})
    for item in checks.get('sequences_unconfirmed') or []:
        look.append({'key': 'sequence', 'text': f"Sequence {item.get('title') or item['id']}: dialogue not confirmed", 'cuts': []})
    return {'steps': steps, 'person': person, 'look': look}


def cmd_analysis(api, args):
    episode = find_episode(api, args.episode, args.latest)
    span = parse_range(args.range)
    report, state = review(api, episode['id'], span), queue(api, episode['id'])
    status = analysis_status(report)
    progress = report['progress']
    setup_missing = [name for name, done in report['setup'].items() if not done]
    lines = [f"{episode['project']} / {episode['title']}  ·  {range_text(span)}  ·  {progress['cuts']} cut(s), {progress['enabled']} with analysis on"]
    lines.append('setup: ' + ('complete' if not setup_missing else 'MISSING ' + ', '.join(setup_missing) + ' (fw setup)'))
    if progress.get('analysis_off'):
        lines.append(f"analysis off (left out of everything below): cuts {numbers_text(progress['analysis_off'])}")

    def render(heading, entries):
        if not entries:
            return
        lines.append(heading)
        for entry in entries:
            numbers = entry['cuts']
            lines.append(f"  {entry['text']}" + (f": cuts {numbers_text(numbers)}" if numbers else '') + (f"  [fw {entry['step']}]" if entry.get('step') else ''))
            if args.links and numbers:
                lines.extend(link_lines(api, episode, numbers, entry['place'], indent='    '))
            for voice in entry.get('voices') or []:
                if args.links:
                    lines.append(f"    - {voice['speaker_label'] or '(no label)'}: {url_at_time(api, episode, voice['first_time']) or ui_link(api, episode)}")

    render('NEEDS A STEP (queue it with the fw command in brackets):', status['steps'])
    render('NEEDS A PERSON (the automatic flow waits for these):', status['person'])
    render('WORTH A LOOK (nothing waits for these):', status['look'])
    if not (status['steps'] or status['person'] or status['look']):
        lines.append('nothing is missing and nothing waits for a person')
    running = ', '.join(f"{run['label']} ({run['stage']})" for run in state.get('running') or []) or 'nothing'
    lines.append(f"queue: running {running}; waiting {state.get('waiting_total', 0)}")
    if report['failures']:
        lines.append(f"failed runs: {len(report['failures'])} (fw failures)")
        if args.links:
            for item in report['failures']:
                span_ = item.get('cut_span')
                url = url_for_number(api, episode, span_['first']) if span_ else None
                lines.append(f"  - {item['label']}: {item['error'][:100]}" + (f"  {url}" if url else ''))
    lines.append(f"episode: {ui_link(api, episode)}")
    emit(args, {'episode': {k: episode[k] for k in ('id', 'title', 'project')}, 'range': span, 'setup': report['setup'],
                'analysis_off': progress.get('analysis_off', []), **status, 'queue': {'running': len(state.get('running') or []), 'waiting': state.get('waiting_total', 0)},
                'failures': len(report['failures']), 'url': ui_link(api, episode)}, '\n'.join(lines))
    return OK


def parse_cut_list(text):
    """'199,204,210-212' -> [199, 204, 210, 211, 212]"""
    numbers = []
    for part in (text or '').split(','):
        first, last = parse_range(part.strip())
        if first is None or last is None:
            raise Failure(f'give cut numbers like 199,204,210-212 (got {part!r})')
        numbers += range(first, last + 1)
    return sorted(set(numbers))


def cmd_links(api, args):
    episode = find_episode(api, args.episode, args.latest)
    numbers = parse_cut_list(args.cuts)
    found = cut_numbers(api, episode)
    missing = [number for number in numbers if number not in found]
    items = [{'cut': number, 'id': found[number]['id'], 'url': cut_url(api, episode, found[number]['id'], args.place)} for number in numbers if number in found]
    text = '\n'.join(f"- cut {item['cut']}: {item['url']}" for item in items)
    if missing:
        text += f"\nno active cut: {numbers_text(missing)}"
    emit(args, {'items': items, 'missing': missing}, text or 'no cuts')
    return ERROR if missing and not items else OK


def cmd_retry(api, args):
    result = api.post(f'/api/jobs/{quote(args.job)}/retry')
    emit(args, result, f"retried {args.job}" + (f" as {', '.join(job_ids(result))}" if job_ids(result) else ''))
    return OK


def cmd_dismiss(api, args):
    emit(args, api.post(f'/api/jobs/{quote(args.job)}/dismiss'), f'dismissed {args.job}')
    return OK


def cmd_cancel(api, args):
    episode = find_episode(api, args.episode, args.latest)
    result = api.post(f"/api/episodes/{episode['id']}/queue/cancel", body={'include_running': args.running, 'group': args.group})
    emit(args, result, f"cancelled {result.get('cancelled', 0)} job(s)")
    return OK


# --- autopilot: agent runs, escalations (docs/autopilot/HARNESS.md) --------------------------------------------

def cut_ids_for(api, episode, text):
    """Editor cut numbers (``12,14,20-22``) as cut ids."""
    numbers, ids = parse_cut_list(text) if text else [], []
    known = cut_numbers(api, episode)
    for number in numbers:
        if number not in known:
            raise Failure(f'there is no cut {number} in this episode')
        ids.append(known[number]['id'])
    return ids


def json_arg(text, name):
    if not text:
        return None
    try:
        return json.loads(text)
    except ValueError as exc:
        raise Failure(f'{name} is not valid JSON: {exc}') from None


def run_line(run):
    counts = run.get('decisions') or {}
    extra = f", {counts.get('total', 0)} decision(s)" + (f", {counts['undone']} undone" if counts.get('undone') else '') \
        + (f", {counts['overridden']} changed by a person" if counts.get('overridden') else '') if counts else ''
    return f"{run['id']}  {run['status']:<8} {run['started_at']}  {run['agent'] or '-'}: {run['purpose'] or '-'}{extra}"


def cmd_agent(api, args):
    if args.action == 'start':
        episode = find_episode(api, args.target, args.latest)
        run = api.post(f"/api/episodes/{episode['id']}/agent-runs", body={'agent': args.agent, 'purpose': args.purpose})
        emit(args, run, run.get('id', ''))
        return OK
    if args.action == 'runs':
        episode = find_episode(api, args.target, args.latest)
        runs = api.get(f"/api/episodes/{episode['id']}/agent-runs")
        emit(args, runs, '\n'.join(run_line(run) for run in runs) or 'no agent runs yet')
        return OK
    if not args.target:
        raise Failure(f'fw agent {args.action} needs a run id')
    if args.action == 'finish':
        run = api.post(f'/api/agent-runs/{args.target}/finish', body={'summary': json_arg(args.summary, '--summary') or {}, 'claude_items': args.claude})
        emit(args, run, run_line(run) if 'id' in run else '')
        return OK
    if args.action == 'undo':
        if args.decision:
            result = api.post(f'/api/agent-decisions/{args.target}/undo')
            emit(args, result, 'undone' if result.get('undone') else 'already undone')
            return OK
        result = api.post(f'/api/agent-runs/{args.target}/undo')
        lines = [f"undid {len(result.get('undone', []))} decision(s)"]
        lines += [f"  kept (changed since): {item['summary'] or item['decision_id']}: {item['reason']}" for item in result.get('conflicts', [])]
        emit(args, result, '\n'.join(lines))
        return OK
    raise Failure(f'unknown action {args.action!r}')


def cmd_inbox(api, args):
    episode = find_episode(api, args.episode, args.latest)
    data = api.get(f"/api/episodes/{episode['id']}/escalations", {'status': args.status, 'reviewer': args.reviewer})
    if args.json:
        emit(args, data, '')
        return OK
    numbers = {cut['id']: number for number, cut in cut_numbers(api, episode).items()}
    counts = data['counts']
    lines = [f"{episode['project']} / {episode['title']}: {counts.get('for_person', counts['open_total'])} open question(s) for you, "
             f"{counts.get('for_claude', 0)} for Claude (the second reviewer), {counts['applied_total']} decision(s) applied by agents"]
    if counts['applied']:
        lines.append('applied: ' + ', '.join(f'{kind} {count}' for kind, count in sorted(counts['applied'].items())))
    for item in data['items']:
        cut_list = sorted(numbers[cut_id] for cut_id in item['cut_ids'] if cut_id in numbers)
        who = ' · for Claude' if item.get('reviewer') == 'claude' else ''
        lines.append(f"\n[{item['kind']}] {item['question']}  ({item['status']}{who}, id {item['id']})")
        if (item.get('evidence') or {}).get('strip'):
            lines.append(f"  picture: {api.url}{item['evidence']['strip']}")
        if (item.get('evidence') or {}).get('claude_note'):
            lines.append(f"  Claude: {item['evidence']['claude_note']}")
        if item['options']:
            lines.append('  options: ' + ' | '.join(str(option) for option in item['options']))
        if item['proposal']:
            lines.append(f"  agent proposes: {json.dumps(item['proposal'], ensure_ascii=False)}")
        if cut_list:
            lines.append(f'  cuts {numbers_text(cut_list)}')
            lines += [f"  - cut {number}: {cut_url(api, episode, cut_numbers(api, episode)[number]['id'], args.place)}" for number in cut_list[:LINK_LIMIT]]
            if len(cut_list) > LINK_LIMIT:
                lines.append(f'  … and {len(cut_list) - LINK_LIMIT} more')
    print('\n'.join(lines))
    return OK


def cmd_escalate(api, args):
    episode = find_episode(api, args.episode, args.latest)
    body = {'kind': args.kind, 'group_key': args.group, 'question': args.question, 'cut_ids': cut_ids_for(api, episode, args.cuts),
            'options': args.option or [], 'proposal': json_arg(args.proposal, '--proposal'), 'evidence': json_arg(args.evidence, '--evidence') or {},
            'run_id': args.run}
    item = api.post(f"/api/episodes/{episode['id']}/escalations", body=body)
    emit(args, item, item.get('id', ''))
    return OK


def cmd_close(api, args):
    item = api.post(f'/api/escalations/{args.escalation}/close', body={'status': args.status, 'resolution': json_arg(args.resolution, '--resolution')})
    emit(args, item, f"{item.get('status', '')}: {item.get('question', '')}")
    return OK


# --- diagnosis and triage (docs/autopilot/HARNESS.md M1) ---------------------------------------------------------

STEP_NAMES = ('boxes', 'target_frames', 'first_frame', 'keyframes', 'beats', 'consistency', 'answers', 'summary')


def fill_command(command, episode):
    """The server writes fw commands with EP for the episode; put the episode's id prefix there (match_episodes takes it)."""
    return command.replace(' EP', f" {episode['id'][:8]}", 1) if command else None


def fix_text(fix, episode):
    if not fix:
        return ''
    if isinstance(fix, str):
        return fix
    command = fill_command(fix.get('command'), episode)
    return fix['text'] + (f"  [{command}]" if command else '')


def cmd_diagnose(api, args):
    episode = find_episode(api, args.episode, args.latest)
    span = parse_range(args.range)
    data = api.get(f"/api/episodes/{episode['id']}/health", {'from_cut': span[0], 'to_cut': span[1]})
    items = [cut for cut in data['cuts'] if not args.kind or any(problem['kind'] == args.kind for problem in cut['problems'])]
    if args.json:
        emit(args, {**data, 'cuts': items}, '')
        return OK
    lines = [f"{episode['project']} / {episode['title']} · {range_text(span)} · {len(items)} of {data['checked']} cut(s) have problems"]
    if data['counts']:
        lines.append('problems: ' + ', '.join(f"{kind.replace('_', ' ')} {count}" for kind, count in sorted(data['counts'].items(), key=lambda pair: -pair[1])))
    if data['episode_problems']:
        lines.append('EPISODE:')
        for item in data['episode_problems']:
            extra = f"  [{fill_command(item['command'], episode)}]" if item.get('command') else ''
            link = f"  {url_at_time(api, episode, item['first_time'])}" if item.get('first_time') is not None else ''
            lines.append(f"  - {item['text']}{extra}{link}")
    lines.append('CUTS, WORST FIRST:' if items else 'no cut has a problem')
    for cut in items[:args.limit]:
        worst = cut['problems'][0]
        busy = f" · in the queue: {', '.join(cut['busy'])}" if cut['busy'] else ''
        lines.append(f"cut {cut['cut']}{busy}: {cut_url(api, episode, cut['cut_id'], worst.get('place') or 'cut')}")
        for problem in cut['problems']:
            fix = fix_text(problem.get('fix'), episode)
            lines.append(f"  - {problem['text']}" + (f"\n      → {fix}" if fix and problem['kind'] in ('failed', 'stale', 'missing') else ''))
    if len(items) > args.limit:
        lines.append(f"… {len(items) - args.limit} more cut(s) (--limit N, --kind KIND or --json)")
    lines.append(f"episode: {ui_link(api, episode)}")
    print('\n'.join(lines))
    return OK


def cmd_why(api, args):
    episode = find_episode(api, args.episode, args.latest)
    if not args.number or not args.number.isdigit():
        raise Failure('give the cut number as shown in the editor, for example: fw why EP 12 --step summary')
    number = int(args.number)
    cut = cut_numbers(api, episode).get(number)
    if not cut:
        raise Failure(f'there is no active cut {number}')
    data = api.get(f"/api/cuts/{cut['id']}/why", {'step': args.step})
    if args.json:
        emit(args, data, '')
        return OK
    lines = [f"cut {number} · {data['chain'][0]['label'] if data['chain'] else data['step']}"]
    for index, link in enumerate(data['chain']):
        lines.append(f"  {'' if index == 0 else '← '}{link['label']} [{link['state']}]: {link['text']}")
    lines.append(f"fix: {fix_text(data['fix'], episode)}")
    lines.append(f"open: {cut_url(api, episode, cut['id'], data.get('place') or 'analysis')}")
    if args.all and data.get('steps'):
        lines.append('every step:')
        lines += [f"  {name:<13} {state['state']:<8} {state['text']}" for name, state in data['steps'].items()]
    print('\n'.join(lines))
    return OK


TRIAGE_HEADINGS = (('applied', 'APPLIED'), ('escalated', 'ASKED A PERSON (fw inbox)'), ('waiting', 'WAITING (GPU busy)'), ('left', 'LEFT ALONE'))
ACTION_WORDS = {'dismiss': 'dismiss (nothing is missing any more)', 'rerun': 'retry from its snapshot', 'requeue': 'queue again with the current settings',
                'prerequisite': 'queue the missing step, then this one', 'wait': 'wait until the GPU is idle', 'escalate': 'ask a person',
                'leave': 'leave it (out of scope)'}


def triage_line(api, episode, item):
    cuts = f" · cuts {numbers_text(item['cuts'])}" if item['cuts'] else ''
    lines = [f"  - {item['label']}{cuts}: {item['cause_text']} → {ACTION_WORDS.get(item['action'], item['action'])}"
             + (f" (attempt {item['attempts'] + 1} of {item['limit']})" if item['action'] in ('rerun', 'requeue', 'prerequisite') else ''),
             f"      error: {item['error'][:200]}"]
    if item.get('why'):
        lines.append(f"      why: {item['why']}")
    if item.get('job_ids'):
        lines.append(f"      queued: {', '.join(item['job_ids'])}")
    if item['cuts']:
        lines += link_lines(api, episode, item['cuts'][:3], 'analysis', indent='      ')
    return lines


def cmd_triage(api, args):
    episode = find_episode(api, args.episode, args.latest)
    if args.go:
        data = api.post(f"/api/episodes/{episode['id']}/triage", body={'run_id': args.run})
        if data.get('dry_run'):
            return OK
        groups = {key: data.get(key) or [] for key, _ in TRIAGE_HEADINGS}
    else:
        data = api.get(f"/api/episodes/{episode['id']}/triage", {'run_id': args.run})
        groups = {'planned': data['items']}
    if args.json:
        emit(args, data, '')
    else:
        total = sum(len(items) for items in groups.values())
        lines = [f"{episode['project']} / {episode['title']}: {total} failed run(s) nobody has dealt with"
                 + (f" · profile mode: {data.get('mode')}" if data.get('mode') else '') + (' · GPU busy' if data.get('gpu_busy') else '')]
        headings = TRIAGE_HEADINGS if args.go else (('planned', 'WHAT TRIAGE WOULD DO (add --go to apply)'),)
        for key, heading in headings:
            if groups.get(key):
                lines.append(heading + ':')
                for item in groups[key]:
                    lines += triage_line(api, episode, item)
        if args.go and data.get('closed_escalations'):
            lines.append(f"closed {data['closed_escalations']} question(s) whose runs no longer fail")
        if not total:
            lines.append('nothing to triage')
        print('\n'.join(lines))
    escalated = groups.get('escalated') or [item for item in groups.get('planned', []) if item['action'] == 'escalate']
    waiting = groups.get('waiting') or [item for item in groups.get('planned', []) if item['action'] == 'wait']
    return BLOCKED if escalated else BUSY if waiting else OK


# --- missed hard cuts (docs/autopilot/HARNESS.md M2) -------------------------------------------------------------

ANSWER_WORDS = {'split': 'split', 'no-cut': 'no_cut', 'no_cut': 'no_cut', 'unsure': 'unsure'}


def cmd_missed_cuts(api, args):
    if args.action in ('check', 'report'):
        episode = find_episode(api, args.target, args.latest)
        span = parse_range(args.extra)
        if args.action == 'check':
            result = api.post(f"/api/episodes/{episode['id']}/missed-cuts", body={'from_cut': span[0], 'to_cut': span[1], 'redo': args.redo, 'run_id': args.run})
            emit(args, result, result.get('detail') or (f"queued the missed-cut check of {range_text(span)}: {result['job_id']}\n"
                                                        f"wait with: fw wait {episode['id'][:8]} --jobs {result['job_id']}" if result.get('job_id') else ''))
            return OK
        data = api.get(f"/api/episodes/{episode['id']}/missed-cuts", {'from_cut': span[0], 'to_cut': span[1]})
        if args.json:
            emit(args, data, '')
            return OK
        counts = data['counts']
        lines = [f"{episode['project']} / {episode['title']} · {range_text(span)}: " + ', '.join(f"{name.replace('_', ' ')} {count}" for name, count in counts.items())]
        splits = [item for item in data['splits'] if not item['undone_at']]
        if splits:
            lines.append(f"SPLIT BY THE AGENT ({len(splits)}; undo one with fw agent undo ID --decision):")
            for item in splits:
                left = (item['after'] or {}).get('left') or {}
                link = cut_url(api, episode, left['id']) if left.get('id') else ''
                lines.append(f"  - {item['summary']} [{item['tier']}]{' (changed by a person since)' if item['overridden_at'] else ''}  id {item['id']}\n    {link}")
        if data['questions']:
            lines.append(f"QUESTIONS ({len(data['questions'])}; answer with fw missed-cuts answer ID split|no-cut|unsure):")
            for item in data['questions']:
                evidence = item['evidence'] or {}
                lines.append(f"  - [{'Claude' if item['reviewer'] == 'claude' else 'person'}] {item['question']}  id {item['id']}")
                lines.append(f"    picture: {api.url}{evidence.get('strip', '')}")
                if evidence.get('cut_id'):
                    lines.append(f"    cut: {cut_url(api, episode, evidence['cut_id'])}")
        print('\n'.join(lines))
        return BLOCKED if data['questions'] else OK
    if not args.target:
        raise Failure(f'fw missed-cuts {args.action} needs an escalation id (fw missed-cuts report EP lists them)')
    if args.action == 'strip':
        question = api.get(f'/api/escalations/{quote(args.target)}')
        evidence = question.get('evidence') or {}
        if question.get('kind') != 'missed_cut' or not evidence.get('strip'):
            raise Failure(f'{args.target} is not a missed-cut question')
        image = api.raw(evidence['strip'].split('?')[0], {'time': evidence['time']})
        out = args.out or f"missed-cut-{args.target[:8]}.jpg"
        with open(out, 'wb') as handle:
            handle.write(image)
        emit(args, {'file': out, 'question': question['question']}, f"{out}\n{question['question']}")
        return OK
    if args.action == 'answer':
        reply = ANSWER_WORDS.get((args.extra or '').lower())
        if not reply:
            raise Failure('answer split, no-cut or unsure')
        result = api.post(f'/api/escalations/{quote(args.target)}/missed-cut', body={'answer': reply, 'tier': args.tier, 'run_id': args.run, 'note': args.note})
        emit(args, result, {'resolved': 'answered' + (f"; split (decision {result['decision_id']})" if result.get('decision_id') else ''),
                            'handed_to_person': 'handed to the person', 'open': 'left open'}.get(result.get('status'), str(result)))
        return OK
    raise Failure(f'unknown action {args.action!r}')


# --- lines across hard cuts (docs/autopilot/HARNESS.md M3) -------------------------------------------------------

def cmd_line_splits(api, args):
    episode = find_episode(api, args.episode, args.latest)
    if args.action == 'run':
        result = api.post(f"/api/episodes/{episode['id']}/line-splits", body={'run_id': args.run})
        emit(args, result, result.get('detail') or f"queued the line splitter: {result['job_id']}\nwait with: fw wait {episode['id'][:8]} --jobs {result['job_id']}")
        return OK
    data = api.get(f"/api/episodes/{episode['id']}/line-splits")
    if args.json:
        emit(args, data, '')
        return OK
    counts = data['counts']
    lines = [f"{episode['project']} / {episode['title']}: {sum(counts.values())} line(s) cross a hard cut · "
             + ', '.join(f"{action} {count}" for action, count in sorted(counts.items()))]
    for item in data['lines']:
        if args.action == 'preview' and item['action'] == 'leave' and not args.all:
            continue
        where = f"cut {item['cut']}" if item['cut'] else ''
        if item['action'] == 'split':
            detail = f"split at {item['at']:.2f}s: “{item['left']}” | “{item['right']}”"
        elif item['action'] == 'trim':
            detail = f"trim to {item['start']:.2f}-{item['end']:.2f}s"
        else:
            detail = 'leave'
        lines.append(f"  - {where} {item['start_time']:.2f}-{item['end_time']:.2f}s, hard cut {item['hard_cut']:.2f}s: {detail} ({item['why']})")
        if item['cut_id'] and item['action'] != 'leave':
            lines.append(f"    {cut_url(api, episode, item['cut_id'], 'analysis')}")
    applied = [item for item in data['applied'] if not item['undone_at']]
    if applied:
        lines.append(f"applied by agents: {len(applied)} (undo one with fw agent undo ID --decision)")
    lines.append(f"run it with: fw line-splits {episode['id'][:8]} run [--run RUN]" if args.action == 'preview' else '')
    print('\n'.join(line for line in lines if line))
    return OK


# --- command line ------------------------------------------------------------------------------------------------

def parser():
    root = argparse.ArgumentParser(prog='fw', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument('--json', action='store_true', help='print the full response as JSON')
    common.add_argument('--url', help=f'server (default {base_url()})')
    common.add_argument('--dry-run', action='store_true', help='print the requests that would change something, send none')
    sub = root.add_subparsers(dest='command', required=True, metavar='COMMAND')

    def episode_command(name, func, help_text, rng=False):
        command = sub.add_parser(name, parents=[common], help=help_text, description=help_text)
        command.add_argument('episode', nargs='?', help='episode id, or text of "Project / Episode"')
        command.add_argument('--latest', action='store_true', help='the newest episode')
        if rng:
            command.add_argument('range', nargs='?', default='all', help='cuts: 100-120, 7, 5-, -10 or all (default)')
        command.set_defaults(func=func)
        return command

    for name, (_, help_text) in STEPS.items():
        command = episode_command(name, cmd_step, help_text, rng=True)
        command.set_defaults(step=name)
        command.add_argument('--redo', action='store_true', help='also cuts that already have it (where the step supports it)')
        command.add_argument('--save', action='store_true', help='answers: save the drafts as your answers instead of suggestions')
        command.add_argument('--language', help='subtitle language for setup/subtitles (default: the episode setting)')
        command.add_argument('--replace-manual', action='store_true', help='transcribe: also replace lines you edited by hand')

    sub.add_parser('health', parents=[common], help='is the server up').set_defaults(func=cmd_health)
    command = sub.add_parser('episodes', parents=[common], help='list episodes')
    command.add_argument('project', nargs='?', help='only projects whose title contains this')
    command.set_defaults(func=cmd_episodes)
    episode_command('status', cmd_status, 'setup, progress, checkpoints, queue and failures in a few lines')
    episode_command('queue', cmd_queue, 'what runs and waits now')
    episode_command('failures', cmd_failures, 'failed runs that wait for a decision, with their errors')
    episode_command('review', cmd_review, 'what waits for a person (exit 2 when a checkpoint is open)', rng=True)
    command = episode_command('analysis', cmd_analysis, 'what every cut still needs: steps, person checkpoints and checks, by cut number', rng=True)
    command.add_argument('--links', action='store_true', help='add one URL per cut under each line (opens the cut at the place that needs it)')
    command = episode_command('links', cmd_links, 'the URL of each cut (cut numbers as in the editor)')
    command.add_argument('cuts', nargs='?', help='cut numbers: 199,204,210-212')
    command.add_argument('--place', default='cut', choices=list(PLACES), help='where the link opens: the cut, or the Analysis dialog at results, run, characters, target-frames or assistant')
    command = episode_command('cut', cmd_cut, 'one cut: what it is missing and what waits for a person')
    command.add_argument('number', nargs='?', help='cut number as shown in the editor')
    for name, func, help_text in (('next', cmd_next, 'the next step of the gated flow (exit 2 blocked, 3 busy)'),
                                  ('drive', cmd_drive, 'repeat next and wait until a person is needed or all is done')):
        command = episode_command(name, func, help_text)
        command.add_argument('--language', help='subtitle language when setup still needs it')
        if name == 'next':
            command.add_argument('--go', action='store_true', help='queue it (otherwise only print it)')
    command = episode_command('wait', cmd_wait, 'wait until the episode queue is empty, or until --jobs finish')
    command.add_argument('--jobs', help='comma-separated job ids to wait for instead of the whole queue')
    command.add_argument('--timeout', type=float, default=0, help='give up after this many seconds (exit 3); 0 waits forever')
    for name, func, help_text in (('retry', cmd_retry, 'run a failed job again'), ('dismiss', cmd_dismiss, 'stop listing a failed job')):
        command = sub.add_parser(name, parents=[common], help=help_text)
        command.add_argument('job')
        command.set_defaults(func=func)
    command = episode_command('cancel', cmd_cancel, "cancel the episode's queued jobs")
    command.add_argument('--group', help='only this waiting group (see fw queue)')
    command.add_argument('--running', action='store_true', help='also stop running jobs at their next checkpoint')
    command = sub.add_parser('agent', parents=[common], help='autopilot runs: start EP, finish RUN, runs EP, undo RUN (or --decision ID)')
    command.add_argument('action', choices=('start', 'finish', 'runs', 'undo'))
    command.add_argument('target', nargs='?', help='episode (start, runs) or run id (finish, undo)')
    command.add_argument('--latest', action='store_true', help='the newest episode')
    command.add_argument('--agent', default='', help='start: who runs it, e.g. claude-code')
    command.add_argument('--purpose', default='', help='start: what this run does')
    command.add_argument('--summary', help='finish: JSON summary of the run')
    command.add_argument('--claude', type=int, default=0, help='finish: items sent to Claude as second reviewer')
    command.add_argument('--decision', action='store_true', help='undo: the target is one decision id, not a run')
    command.set_defaults(func=cmd_agent)
    command = episode_command('inbox', cmd_inbox, 'what the agents escalated to a person, with cut links, and what they applied')
    command.add_argument('--status', default='open', choices=('open', 'resolved', 'dismissed', 'all'))
    command.add_argument('--reviewer', choices=('claude', 'human'), help="only the second reviewer's queue (claude) or the person's (human)")
    command.add_argument('--place', default='analysis', choices=list(PLACES), help='where the cut links open')
    command = episode_command('escalate', cmd_escalate, 'open (or update) one question for a person; one per kind and group')
    command.add_argument('--kind', required=True, help='e.g. new_character, voice, review_answer, missed_cut')
    command.add_argument('--group', required=True, help='what groups the cuts, e.g. face:cluster-3 or SPEAKER_04')
    command.add_argument('--question', required=True)
    command.add_argument('--cuts', help='cut numbers: 12,14,20-22')
    command.add_argument('--option', action='append', help='an answer the person can pick (repeat)')
    command.add_argument('--proposal', help="JSON: the agent's own answer")
    command.add_argument('--evidence', help='JSON: why it asks')
    command.add_argument('--run', help='the agent run that asks')
    command = episode_command('diagnose', cmd_diagnose, 'per cut, what is wrong and why, worst cuts first (failed, stale, contradictions, missing, lines across cuts)', rng=True)
    command.add_argument('--limit', type=int, default=30, help='how many cuts to list (default 30)')
    command.add_argument('--kind', choices=('failed', 'stale', 'contradiction', 'person', 'missing', 'line_crossing', 'auto_labels', 'no_boxes'),
                         help='only cuts with this kind of problem')
    command = episode_command('why', cmd_why, "why one cut's step is not done: its prerequisites down to the first broken one")
    command.add_argument('number', nargs='?', help='cut number as shown in the editor')
    command.add_argument('--step', choices=STEP_NAMES, help='the step to explain (default: the earliest one not done)')
    command.add_argument('--all', action='store_true', help='also list the state of every step')
    command = episode_command('triage', cmd_triage, 'classify failed runs and the fix rule for each; --go applies them as agent decisions (exit 2 asked a person, 3 waiting)')
    command.add_argument('--go', action='store_true', help='apply the fixes (otherwise only print the plan)')
    command.add_argument('--run', help='the agent run the fixes belong to (fw agent start)')
    command = sub.add_parser('missed-cuts', parents=[common], help='hard cuts the detection missed: check EP [RANGE], report EP [RANGE], strip ID, answer ID split|no-cut|unsure')
    command.add_argument('action', choices=('check', 'report', 'strip', 'answer'))
    command.add_argument('target', nargs='?', help='episode (check, report) or question id (strip, answer)')
    command.add_argument('extra', nargs='?', help='check/report: the cut range; answer: split, no-cut or unsure')
    command.add_argument('--latest', action='store_true', help='the newest episode')
    command.add_argument('--redo', action='store_true', help='check: also cuts already checked with these boundaries')
    command.add_argument('--run', help='the agent run (fw agent start)')
    command.add_argument('--tier', default='human', choices=('claude', 'human'), help='answer: who answers (claude = the second reviewer)')
    command.add_argument('--note', help='answer: why (kept with the question)')
    command.add_argument('--out', help='strip: file to write (default missed-cut-ID.jpg)')
    command.set_defaults(func=cmd_missed_cuts)
    command = episode_command('line-splits', cmd_line_splits, 'transcript lines across hard cuts: preview what the splitter would do, or run it')
    command.add_argument('action', nargs='?', default='preview', choices=('preview', 'run'))
    command.add_argument('--run', help='run: the agent run the changes belong to')
    command.add_argument('--all', action='store_true', help='preview: also the lines it would leave as they are')
    command = sub.add_parser('close', parents=[common], help='close an escalation: resolved or dismissed')
    command.add_argument('escalation')
    command.add_argument('--status', default='resolved', choices=('resolved', 'dismissed'))
    command.add_argument('--resolution', help='JSON: what was decided')
    command.set_defaults(func=cmd_close)
    return root


def main(argv=None):
    args = parser().parse_args(argv)
    if getattr(args, 'latest', False) and args.episode:
        # `fw boxes --latest 100-120` / `fw cut --latest 7`: the first positional is the range or the cut number
        if getattr(args, 'range', None) == 'all':
            args.range, args.episode = args.episode, None
        elif hasattr(args, 'number') and args.number is None:
            args.number, args.episode = args.episode, None
        elif hasattr(args, 'cuts') and args.cuts is None:
            args.cuts, args.episode = args.episode, None
    api = Api(args.url.rstrip('/') if getattr(args, 'url', None) else base_url(), dry_run=getattr(args, 'dry_run', False))
    try:
        return args.func(api, args)
    except Failure as exc:
        print(f'error: {exc}', file=sys.stderr)
        return ERROR
    except KeyboardInterrupt:
        return ERROR


if __name__ == '__main__':
    sys.exit(main())
